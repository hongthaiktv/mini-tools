							read -rsn1 -p "Press any key to continue..." key
						fi
					fi
				fi
				;;

			"Verify Contact")
				printf "\033[$(( ${#menuContacts[@]} + 1 ))A\033[0J"
				local contactEmails=( $(grep -Eo " [^ ]+@[^ ]+\. " <<< "$contacts" | sed -E "s/^ ([^ ]+@[^ ]+)\. /\1/") )
				tmenu "${contactEmails[@]}"

				local contactEmail=""
				for (( i=0 ; i<${#contactEmails[@]} ; i++ )); do
					if [[ "$TMENU_RESULT" == "${contactEmails[$i]}" ]]; then
						contactEmail="${contactEmails[$i]}"
						break
					fi
				done

				if [[ ! -z "$contactEmail" ]]; then
					local verifyResult="$(mega-users --verify "$contactEmail")"
					if [[ ! -z "$verifyResult" ]]; then
						printf "$(sed -E "s/([^ ]+@[^ \"]+)/\\\033[1;36m\1\\\033[0m/" <<< "$verifyResult")\n"
					fi
					echo
					read -rsn1 -p "Press any key to continue..." key
				fi
				;;

			"Unverify Contact")
				printf "\033[$(( ${#menuContacts[@]} + 1 ))A\033[0J"
				local contactEmails=( $(grep -Eo " [^ ]+@[^ ]+\. " <<< "$contacts" | sed -E "s/^ ([^ ]+@[^ ]+)\. /\1/") )
				tmenu "${contactEmails[@]}"

				local contactEmail=""
				for (( i=0 ; i<${#contactEmails[@]} ; i++ )); do
					if [[ "$TMENU_RESULT" == "${contactEmails[$i]}" ]]; then
						contactEmail="${contactEmails[$i]}"
						break
					fi
				done

				if [[ ! -z "$contactEmail" ]]; then
					local unVerifyResult="$(mega-users --unverify "$contactEmail")"
					if [[ ! -z "$unVerifyResult" ]]; then
						printf "$(sed -E "s/([^ ]+@[^ \"]+)/\\\033[1;36m\1\\\033[0m/" <<< "$unVerifyResult")\n"
					fi
					echo
					read -rsn1 -p "Press any key to continue..." key
				fi
				;;

			"Help Verify Contact")
				printf "\033[$(( ${#menuContacts[@]} + 1 ))A\033[0J"
				local contactEmails=( $(grep -Eo " [^ ]+@[^ ]+\. " <<< "$contacts" | sed -E "s/^ ([^ ]+@[^ ]+)\. /\1/") )
				tmenu "${contactEmails[@]}"

				local contactEmail=""
				for (( i=0 ; i<${#contactEmails[@]} ; i++ )); do
					if [[ "$TMENU_RESULT" == "${contactEmails[$i]}" ]]; then
						contactEmail="${contactEmails[$i]}"
						break
					fi
				done

				if [[ ! -z "$contactEmail" ]]; then
					local helpVerifyResult="$(mega-users --help-verify "$contactEmail")"
					if [[ ! -z "$helpVerifyResult" ]]; then
						printf "$(sed -E "s/([^ ]+@[^ \"]+)/\\\033[1;36m\1\\\033[0m/" <<< "$helpVerifyResult")\n"
					fi
					echo
					read -rsn1 -p "Press any key to continue..." key
				fi
				;;
		esac
	done
}

action.megaMenu() {
	clear
	local title="\033[41m MEGA MENU (\033[1;32m%s\033[0m\033[41m) ${lineSpacer:0:$(( ${#lineSpacer} - 14 - ${#megauser} ))}\033[0m\n\033[41m%s\033[0m\n\033[47m\033[1;30m %s ${lineSpacer:0:$(( ${#lineSpacer} - 2 - ${#storageInfo} ))}\033[0m\n\n[D:\033[1;34m%s\033[0m | F:\033[1;33m%s\033[0m] \033[1;36m%s\033[0m\n(Esc+m: Back)\n\n"
	printf "$title" "$megauser" "$lineSeparator" "$storageInfo" "$numDir" "$numFile" "$MEGAWDIR"

	declare -a menuList

	if [[ "$megauser" != 'Shared Link' ]]; then
		menuList+=( "Account Info" "Export Links (All)" )
	fi

	menuList+=( "Session ID" )

	if [[ "$megauser" != 'Shared Link' ]]; then
		menuList+=( "Close All Sessions" "Contacts" "Mount" )
	fi

	menuList+=( "Transfer Logs" "Logout" )

	unset MEGA_FILE_TYPES
	tmenu "${menuList[@]}"

	case "$TMENU_RESULT" in
		"$ESC_KEY"'q')
			TMENU_RESULT='MAINMENU'
			;;

		"$ESC_KEY"'e')
			TMENU_RESULT='EXIT'
			;;

		"Account Info")
			mega-whoami -l
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Export Links (All)")
			local exportLinks="$(mega-export '/' | grep "^[^ ]")"
			local exportTotal="$(grep -c "." <<< "$exportLinks")"
			printf "Total exported links: \033[1;32m%s\033[0m\n\n" "$exportTotal"

			local prevIFS="$IFS"
			while IFS= read -r line; do
				local exportPath="$(sed -E s/"^(.+) \([^s].*"/"\1"/ <<< "$line")"
				local exportLink="$(grep -Eio 'https://[^) ]+' <<< "$line")"
				local exportAuthToken="$(grep -Eio 'AuthToken=[^)]+' <<< "$line" | sed -E s/'^AuthToken='//)"
				if [[ "$line" == *" (folder"* ]]; then
					exportPath="\033[1;34m$exportPath\033[0m"
				fi
				if [[ ! -z "$exportAuthToken" ]]; then
					exportAuthToken="\nAuthToken: $(grep -Eio "^.+:" <<< "$exportAuthToken")\033[1;31m$(sed -E s/'^.+:'// <<< "$exportAuthToken")\033[0m"
				fi
				printf "Path: $exportPath\n\033[1;36m%s\033[0m$exportAuthToken\n\n" "$exportLink"
			done <<< "$exportLinks"
			IFS="$prevIFS"

			read -rsn1 -p "Press any key to continue..." key
			;;

		"Session ID")
			mega-session
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Close All Sessions")
			local msg="Close \033[1;31m%s\033[0m other sessions? (y/N): "
			printf "$msg" "**All**"
			read -rn1 key
			echo
			echo

			if [[ "$key" == "y" || "$key" == "Y" ]]; then
				mega-killsession -a
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Contacts")
			action.megaContact
			;;

		"Mount")
			mega-mount
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Transfer Logs")
			mega-transfers --show-completed --limit=50 --output-cols=TYPE,TAG,SOURCEPATH,DESTINYPATH,PROGRESS
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Logout")
			local msg="Clear the \033[1;31m%s\033[0m and \033[1;31m%s\033[0m? (y/n/C): "
			printf "$msg" "current session" "cached data"
			read -rn1 key
			echo
			echo

			if [[ "$key" == "y" || "$key" == "Y" ]]; then
				mega-logout
				if [[ $? -ne 0 ]]; then
					echo
					read -rsn1 -p "Press any key to continue..." key
				else
					TMENU_RESULT='MAINMENU'
				fi
			elif [[ "$key" == "n" || "$key" == "N" ]]; then
				mega-logout --keep-session
				if [[ $? -eq 0 ]]; then
					TMENU_RESULT='MAINMENU'
				fi
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;
	esac
}

action.megaDir() {
	local title="\033[41m Mega Directory Action \033[0m\n\033[41m --------------------- \033[0m\n\n"
	printf "$title"

	local actions=( "Upload" )

	if [[ ! -z "$DST" ]]; then
		local prevDST="$(basename "$DST")"
		actions+=( "Download to \"$prevDST\"" )
	fi

	actions+=( "Download" )

	if [[ "$MEGAWDIR" != '/' || "$MEGAWDIR" == '/' && "$1" != '.' ]]; then
		actions+=( "Copy" "Move" )
	fi

	if [[ "$1" == '.' && "$MEGAWDIR" == '//bin' ]]; then
		actions+=( "Empty Trash" )
	elif [[ "$MEGAWDIR" == '//bin'* ]]; then
		actions+=( "Delete" )
	else
		if [[ ("$megauser" != 'Shared Link' && "$MEGAWDIR" != '/') || ("$megauser" != 'Shared Link' && "$MEGAWDIR" == '/' && "$1" != '.') ]]; then
			actions+=( "Move to Trash" )
		elif [[ ("$megauser" == 'Shared Link' && "$MEGAWDIR" != '/') || ("$megauser" == 'Shared Link' && "$MEGAWDIR" == '/' && "$1" != '.') ]]; then
			actions+=( "Delete" )
		fi
	fi

	if [[ "$MEGAWDIR" != '/' || "$MEGAWDIR" == '/' && "$1" != '.' ]]; then
		actions+=( "Rename" )
	fi

	actions+=( "New folder" )

	if [[ "$1" == '.' && "$MEGAWDIR" == '/' ]]; then
		actions+=( "Find (Root)" )
	else
		actions+=( "Find" )
	fi

	if [[ "$1" == '.' ]]; then
		if [[ "$MEGAWDIR" != '/' ]]; then
			if [[ "$megauser" != 'Shared Link' ]]; then
				actions+=( "Export" )
			fi
		fi

		for fileType in "${MEGA_FILE_TYPES[@]}"; do
			if [[ "$fileType" == 'dep' || "$fileType" == 'ep' ]]; then
				if [[ "$MEGAWDIR" == '/' ]]; then
					actions+=( "Export Links (All)" )
				else
					actions+=( "Export Links" )
				fi
				break
			fi
		done

		if [[ "$MEGAWDIR" != '/' ]]; then
			if [[ "$megauser" != 'Shared Link' ]]; then
				actions+=( "Disable Export" )
			fi
		fi
	elif [[ "${MEGA_FILE_TYPES[$index]}" == 'dep' ]]; then
		actions+=( "Export Links" "Disable Export" )
	else
		if [[ "$megauser" != 'Shared Link' ]]; then
			actions+=( "Export" )
		fi
	fi

	if [[ "$megauser" != 'Shared Link' ]]; then
		actions+=( "Import Link" )
	fi

	actions+=( "Usage" "Detail" )

	unset MEGA_FILE_TYPES
	tmenu "${actions[@]}"

	case "$TMENU_RESULT" in
		"Upload")
			tmenu.fileExplorer "slFile"
			if [[ "$TMENU_RESULT" != "$ESC_KEY" ]]; then
				mega-put "$TMENU_RESULT" "$1"
				if [[ "$megauser" != 'Shared Link' ]]; then
					getMegaUsedStorage
				fi
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Download to \"$prevDST\"")
			mega-get "$1" "$DST"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Download")
			tmenu.fileExplorer "slDst"
			if [[ "$TMENU_RESULT" != "$ESC_KEY" ]]; then
				mega-get "$1" "$TMENU_RESULT"
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Copy")
			tmenu.megaExplorer "megaSlDst"
			if [[ "$TMENU_RESULT" != "$ESC_KEY" ]]; then
				mega-cp "$1" "$TMENU_RESULT"
			else
				local cDst
				read -rep "Destination: (cancel) " cDst
				if [[ ! -z "$cDst" ]]; then
					mega-cp "$1" "$cDst"
				fi
			fi

			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			elif [[ "$TMENU_RESULT" != "$ESC_KEY" || ! -z "$cDst" ]]; then
				if [[ "$megauser" != 'Shared Link' ]]; then
					getMegaUsedStorage
				fi
			fi
			;;

		"Move")
			tmenu.megaExplorer "megaSlDst"
			if [[ "$TMENU_RESULT" != "$ESC_KEY" ]]; then
				mega-mv "$1" "$TMENU_RESULT"
				if [[ $? -eq 0 ]]; then
					if [[ "$1" == '.' ]]; then
						MEGAWDIR="$(mega-pwd)"
						if [[ "$megauser" == 'Shared Link' ]]; then
							MEGAWDIR="$(sed -E "s|^\/[^/]*\/?|\/|" <<< "$MEGAWDIR")"
						fi
					fi
				else
					echo
					read -rsn1 -p "Press any key to continue..." key
				fi
			fi
			;;

		"Empty Trash")
			local msg="Clear \033[1;31m%s\033[0m? (y/N): "
			printf "$msg" "Trash bin"
			read -rn1 key
			echo
			echo

			if [[ "$key" == "y" || "$key" == "Y" ]]; then
				mega-rm -rf "//bin/*"
				if [[ $? -ne 0 ]]; then
					echo
					read -rsn1 -p "Press any key to continue..." key
				else
					unset prevItem
				fi
				if [[ "$megauser" != 'Shared Link' ]]; then
					getMegaUsedStorage
				fi
			fi
			;;

		"Move to Trash")
			if [[ "$1" == '.' && "$MEGAWDIR" == '/' ]]; then
				local msg="Can't move root \033[1;31m%s\033[0m to Trash bin. "
				printf "$msg" "$MEGAWDIR"
				read -rsn1 key
				return -1
			fi

			local dirName="$1"
			local msg="Move \033[1;31m%s\033[0m to Trash bin? (y/N): "
			if [[ "$1" == '.' ]]; then
				dirName="$(basename "$MEGAWDIR")"
				local parentDir="$(sed -E s/^\(.*\)\\/.*/"\1"/ <<< "$MEGAWDIR")"
			fi
			printf "$msg" "$dirName"
			read -rn1 key
			echo
			echo

			if [[ "$key" == "y" || "$key" == "Y" ]]; then
				mega-mv "$1" '//bin'
				if [[ $? -ne 0 ]]; then
					echo
					read -rsn1 -p "Press any key to continue..." key
				else
					if [[ "$1" == '.' ]]; then
						mega-cd "$parentDir"
						MEGAWDIR="$parentDir"
					fi
					if [[ "$megauser" != 'Shared Link' ]]; then
						getMegaUsedStorage
					fi
					unset prevItem
				fi
			fi
			;;

		"Delete")
			local dirName="$1"
			local msg="Delete \033[1;31m%s\033[0m permanently? (y/N): "
			if [[ "$1" == '.' ]]; then
				dirName="$(basename "$MEGAWDIR")"
				local parentDir="$(sed -E s/^\(.*\)\\/.*/"\1"/ <<< "$MEGAWDIR")"
			fi
			printf "$msg" "$dirName"
			read -rn1 key
			echo
			echo

			if [[ "$key" == "y" || "$key" == "Y" ]]; then
				mega-rm -rf "$1"
				if [[ $? -ne 0 ]]; then
					echo
					read -rsn1 -p "Press any key to continue..." key
				else
					if [[ "$1" == '.' ]]; then
						mega-cd "$parentDir"
						MEGAWDIR="$parentDir"
					fi
					if [[ "$megauser" != 'Shared Link' ]]; then
						getMegaUsedStorage
					fi
					unset prevItem
				fi
			fi
			;;

		"Rename")
			local newName=""
			read -rep "New name: (cancel) " newName
			echo
			if [[ ! -z "$newName" ]]; then
				mega-mv "$1" "$newName"
			fi

			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"New folder")
			local fName=""
			read -rep "Folder name: (cancel) " fName
			echo
			if [[ ! -z "$fName" ]]; then
				mega-mkdir "$1/$fName"
			fi

			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Find" | "Find (Root)")
			if [[ "$1" == '.' ]]; then
				action.megaFind "$MEGAWDIR"
			else
				action.megaFind "$MEGAWDIR/$1"
			fi
			;;

		"Import Link")
			read -rep 'Shared link: (cancel) ' megaLink
			if [[ ! -z "$megaLink" ]]; then
				read -rsep 'Password protected: (none) ' passwordLink
				echo

				if [[ -z "$passwordLink" ]]; then
					mega-import "$megaLink" "$1"
				else
					mega-import "$megaLink" --password="$passwordLink" "$1"
				fi

				if [[ $? -ne 0 ]]; then
					echo
					read -rsn1 -p "Press any key to continue..." key
				fi
			fi
			;;

		"Export")
			local msg="Export folder with \033[1;31m%s\033[0m? (y/n/C): "
			printf "$msg" "writable"
			read -rn1 key
			echo
			echo

			if [[ "$key" == "y" || "$key" == "Y" ]]; then
				mega-export -af --writable "$1"
				echo
				read -rsn1 -p "Press any key to continue..." key
			elif [[ "$key" == "n" || "$key" == "N" ]]; then
				mega-export -af "$1"
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Export Links" | "Export Links (All)")
			local exportLinks="$(mega-export "$1" | grep "^[^ ]")"
			local exportTotal="$(grep -c "." <<< "$exportLinks")"
			local msg='Exported links: '

			if [[ "$1" == '.' && "$MEGAWDIR" == '/' ]]; then
				msg='Total exported links: '
			fi
			printf "%s\033[1;32m%s\033[0m\n\n" "$msg" "$exportTotal"

			local prevIFS="$IFS"
			while IFS= read -r line; do
				local exportPath="$(sed -E s/"^(.+) \([^s].*"/"\1"/ <<< "$line")"
				local exportLink="$(grep -Eio 'https://[^) ]+' <<< "$line")"
				local exportAuthToken="$(grep -Eio 'AuthToken=[^)]+' <<< "$line" | sed -E s/'^AuthToken='//)"
				if [[ "$line" == *" (folder"* ]]; then
					exportPath="\033[1;34m$exportPath\033[0m"
				fi
				if [[ ! -z "$exportAuthToken" ]]; then
					exportAuthToken="\nAuthToken: $(grep -Eio "^.+:" <<< "$exportAuthToken")\033[1;31m$(sed -E s/'^.+:'// <<< "$exportAuthToken")\033[0m"
				fi
				printf "Path: $exportPath\n\033[1;36m%s\033[0m$exportAuthToken\n\n" "$exportLink"
			done <<< "$exportLinks"
			IFS="$prevIFS"

			read -rsn1 -p "Press any key to continue..." key
			;;

		"Disable Export")
			mega-export -d "$1"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Usage")
			local item="$1"
			if [[ "$item" == '.' ]]; then
				item='*'
			elif [[ "$item" == '..' ]]; then
				if [[ "$MEGAWDIR" == '/' || "$MEGAWDIR" == '//bin' ]]; then
					item='*'
				else
					item="$(sed -E s/^\(.*\)\\/.*/"\1"/ <<< "$MEGAWDIR")/*"
				fi
			fi
			mega-du -h "$item"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Detail")
			local item="$1"
			if [[ "$item" == '..' ]]; then
				if [[ "$MEGAWDIR" == '/' || "$MEGAWDIR" == '//bin' ]]; then
					item='.'
				else
					item="$(sed -E s/^\(.*\)\\/.*/"\1"/ <<< "$MEGAWDIR")/."
				fi
			fi
			mega-ls -lh --versions --show-handles "$item"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;
	esac
}

