				echo
				read -rsn1 -p "Press any key to continue..." key
			elif [[ "$TMENU_RESULT" != "$ESC_KEY" || ! -z "$cDst" ]]; then
				if [[ "$megauser" != 'Shared Link' ]]; then
					getMegaUsedStorage
				fi
			fi
			;;

		"Move")
			tmenu.megaExplorer "megaSlDst"
			if [[ "$TMENU_RESULT" != "$ESC_KEY" ]]; then
				mega-mv "$1" "$TMENU_RESULT"
				if [[ $? -ne 0 ]]; then
					echo
					read -rsn1 -p "Press any key to continue..." key
				fi
			fi
			;;

		"Move to Trash")
			local msg="Move \033[1;31m%s\033[0m to Trash bin? (y/N): "
			printf "$msg" "$1"
			read -rn1 key
			echo
			echo

			if [[ "$key" == "y" || "$key" == "Y" ]]; then
				mega-mv "$1" '//bin'
				if [[ $? -ne 0 ]]; then
					echo
					read -rsn1 -p "Press any key to continue..." key
				else
					if [[ "$megauser" != 'Shared Link' ]]; then
						getMegaUsedStorage
					fi
					unset prevItem
				fi
			fi
			;;

		"Delete")
			local msg="Delete \033[1;31m%s\033[0m permanently? (y/N): "
			printf "$msg" "$1"
			read -rn1 key
			echo
			echo

			if [[ "$key" == "y" || "$key" == "Y" ]]; then
				mega-rm -f "$1"
				if [[ $? -ne 0 ]]; then
					echo
					read -rsn1 -p "Press any key to continue..." key
				else
					if [[ "$megauser" != 'Shared Link' ]]; then
						getMegaUsedStorage
					fi
					unset prevItem
				fi
			fi
			;;

		"Rename")
			local newName=""
			read -rep "New name: (cancel) " newName
			echo
			if [[ ! -z "$newName" ]]; then
				mega-mv "$1" "$newName"
			fi

			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Export")
			mega-export -af "$1"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Export Link")
			local prevIFS="$IFS"
			while IFS= read -r line; do
				local exportPath="$(sed -E s/"^(.+) \([^s].*"/"\1"/ <<< "$line")"
				local exportLink="$(grep -Eio 'https://[^) ]+' <<< "$line")"
				local exportAuthToken="$(grep -Eio 'AuthToken=[^)]+' <<< "$line" | sed -E s/'^AuthToken='//)"
				if [[ "$line" == *" (folder"* ]]; then
					exportPath="\033[1;34m$exportPath\033[0m"
				fi
				if [[ ! -z "$exportAuthToken" ]]; then
					exportAuthToken="\nAuthToken: $(grep -Eio "^.+:" <<< "$exportAuthToken")\033[1;31m$(sed -E s/'^.+:'// <<< "$exportAuthToken")\033[0m"
				fi
				printf "Path: $exportPath\n\033[1;36m%s\033[0m$exportAuthToken\n\n" "$exportLink"
			done < <(mega-export "$1" | grep "^[^ ]")
			IFS="$prevIFS"

			read -rsn1 -p "Press any key to continue..." key
			;;

		"Disable Export")
			mega-export -d "$1"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Versions")
			printf "\033[$(( ${#actions[@]} + 4 ))A\033[0J"
			local title="\033[41m Select File Version \033[0m\n\033[41m ------------------- \033[0m\n\n"
			printf "$title"

			local fileHandles=( $(mega-ls -lh --versions --show-handles "$1" | grep -E "$1#.+" | grep -oE "[a-zA-Z]:[^ ]+") )
			tmenu "${fileHandles[@]}"

			local fileHandle=""
			for (( i=0 ; i<${#fileHandles[@]} ; i++ )); do
				if [[ "$TMENU_RESULT" == "${fileHandles[$i]}" ]]; then
					fileHandle="${fileHandles[$i]}"
					break
				fi
			done

			if [[ ! -z "$fileHandle" ]]; then
				action.megaFile "$TMENU_RESULT"
			fi
			;;

		"Usage")
			mega-du -h "$1"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Detail")
			mega-ls -lh --versions --show-handles "$1"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;
	esac
}

tmenu.megaExplorer() {
	megaLogin
	if [[ $? -ne 0 ]]; then
		return -1
	fi

	MEGAWDIR="$(mega-pwd)"
	if [[ "$megauser" == 'Shared Link' ]]; then
		MEGAWDIR="$(sed -E "s|^\/[^/]*\/?|\/|" <<< "$MEGAWDIR")"
	fi

	MEGASRC="$MEGAWDIR"
	MEGADST="$MEGAWDIR"
	local lineSpacer="                                                        "
	local lineSeparator=" ------------------------------------------------------ "
	local title=""
	local prevItem=""
	local index=-1
	local storageInfo=""
	local txtEscI=""
	local txtEscT=""

	if [[ "$1" == "megaSlDst" || "$1" == "megaSlFile" ]]; then
		if [[ "$MEGASRC" == '//bin'* || "$MEGASRC" == '//in'* ]]; then
			MEGASRC="/"
		fi
		mega-cd "$MEGASRC"
		MEGAWDIR="$MEGASRC"
	else
		getMegaUsedStorage
	fi

	until [[ "$TMENU_RESULT" == 'EXIT' || "$TMENU_RESULT" == 'MAINMENU' ]]; do
		clear
		local file_list=( "." ".." )
		MEGA_FILE_TYPES=( "d" "d" )
		local checkPrev=0
		if [[ "$prevItem" == '.' || "$prevItem" == '..' ]]; then
			prevItem=""
		fi

		local allFiles="$(mega-ls -lh --show-handles)"
		local numDir=0
		local numFile=0
		local prevIFS="$IFS"
		while IFS= read -r line; do
			if [[ "$line" == 'dep'* ]]; then
				MEGA_FILE_TYPES+=( "dep" )
			else
				MEGA_FILE_TYPES+=( "d" )
			fi
			file_list+=( "$(sed -E s/"^.+[a-zA-Z]:[^ ]+ (.+)$"/"\1"/ <<< "$line")" )
			(( ++numDir ))
		done < <(grep -i "^d" <<< "$allFiles")

		while IFS= read -r line; do
			if [[ "$line" == ?'ep'* ]]; then
				MEGA_FILE_TYPES+=( "ep" )
			else
				MEGA_FILE_TYPES+=( "f" )
			fi
			file_list+=( "$(sed -E s/"^.+[a-zA-Z]:[^ ]+ (.+)$"/"\1"/ <<< "$line")" )
			(( ++numFile ))
		done < <(grep -Eiv "^d|FLAGS" <<< "$allFiles")
		IFS="$prevIFS"

		if [[ -z "$1" ]]; then
			if [[ "$MEGAWDIR" == '//bin'* ]]; then
				storageInfo="$megaUsedTrashBin"
				txtEscI="Inbox"
				txtEscT="Files"
			elif [[ "$MEGAWDIR" == '//in'* ]]; then
				storageInfo="$megaUsedInbox"
				txtEscI="Files"
				txtEscT="Trash"
			else
				storageInfo="$megaUsedStorage"
				txtEscI="Inbox"
				txtEscT="Trash"
			fi
			if [[ "$megauser" != 'Shared Link' ]]; then
				title="\033[41m MEGA FILE EXPLORER (\033[1;32m%s\033[0m\033[41m) ${lineSpacer:0:$(( ${#lineSpacer} - 23 - ${#megauser} ))}\033[0m\n\033[41m%s\033[0m\n\033[47m\033[1;30m %s ${lineSpacer:0:$(( ${#lineSpacer} - 2 - ${#storageInfo} ))}\033[0m\n\n[D:\033[1;34m%s\033[0m | F:\033[1;33m%s\033[0m] \033[1;36m%s\033[0m\n(0: Action | Esc+i: %s | Esc+t: %s | Esc+m: Menu)\n\n"
				printf "$title" "$megauser" "$lineSeparator" "$storageInfo" "$numDir" "$numFile" "$MEGAWDIR" "$txtEscI" "$txtEscT"
			else
				title="\033[41m MEGA FILE EXPLORER (\033[1;32m%s\033[0m\033[41m) ${lineSpacer:0:$(( ${#lineSpacer} - 23 - ${#megauser} ))}\033[0m\n\033[41m%s\033[0m\n\033[47m\033[1;30m Shared Directory: \033[1;34m%s ${lineSpacer:0:$(( ${#lineSpacer} - 20 - ${#storageInfo} ))}\033[0m\n\n[D:\033[1;34m%s\033[0m | F:\033[1;33m%s\033[0m] \033[1;36m%s\033[0m\n(0: Action | Esc+l: Logout | Esc+m: Menu)\n\n"
				printf "$title" "$megauser" "$lineSeparator" "$storageInfo" "$numDir" "$numFile" "$MEGAWDIR"
			fi
		elif [[ "$1" == "megaSlDst" ]]; then
			title="\033[42m MEGA SELECT DESTINATION \033[0m\n\033[42m ----------------------- \033[0m\n\n[D:\033[1;34m%s\033[0m | F:\033[1;33m%s\033[0m] \033[1;36m%s\033[0m\n(0: Select)\n\n"
			printf "$title" "$numDir" "$numFile" "$MEGAWDIR"
		elif [[ "$1" == "megaSlFile" ]]; then
			title="\033[42m MEGA SELECT FILE/FOLDER \033[0m\n\033[42m ----------------------- \033[0m\n\n[D:\033[1;34m%s\033[0m | F:\033[1;33m%s\033[0m] \033[1;36m%s\033[0m\n(0: Select)\n\n"
			printf "$title" "$numDir" "$numFile" "$MEGAWDIR"
		fi

		for file in "${file_list[@]}"; do
			if [[ "$file" == "$prevItem" ]]; then
				checkPrev=1
				break
			fi
		done

		if [[ -z "$prevItem" || ! -z "$prevItem" && $checkPrev == 0 ]]; then
			if [[ ! -z "${file_list[2]}" ]]; then
				prevItem=${file_list[2]}
			else
				prevItem=".."
			fi
		fi
		
		tmenu "$prevItem" "${file_list[@]}"
		
		prevItem="$MENU_SELECTED"

		for (( i=0 ; i<${#file_list[@]} ; i++ )); do
			local file="${file_list[$i]}"
			if [[ "$file" == "$MENU_SELECTED" ]]; then
				index=$i
				break
			fi
		done

		if [[ "$TMENU_RESULT" == "$ESC_KEY" ]]; then
			break
		elif [[ "$TMENU_RESULT" == "$ESC_KEY"'q' ]]; then
			TMENU_RESULT='MAINMENU'
		elif [[ "$TMENU_RESULT" == "$ESC_KEY"'e' ]]; then
			TMENU_RESULT='EXIT'
		elif [[ "$TMENU_RESULT" == "$ESC_KEY"'a' ]]; then
			mega-cd '/'
			MEGAWDIR='/'
		elif [[ "$TMENU_RESULT" == "$ESC_KEY"'m' ]]; then
			action.megaMenu
		elif [[ "$TMENU_RESULT" == "$ESC_KEY"'f' ]]; then
			action.megaFind '/'
		elif [[ "$TMENU_RESULT" == "$ESC_KEY"'u' ]]; then
			action.megaContact
		elif [[ "$TMENU_RESULT" == "$ESC_KEY"'i' ]]; then
			if [[ "$MEGAWDIR" == '//in'* ]]; then
				if [[ "$MEGASRC" == '//bin'* || "$MEGASRC" == '//in'* ]]; then
					MEGASRC="/"
				fi
				mega-cd "$MEGASRC"
				MEGAWDIR="$MEGASRC"
			else
				if [[ "$MEGAWDIR" != '//bin'* && "$MEGAWDIR" != '//in'* ]]; then
					MEGASRC="$MEGAWDIR"
				fi
				mega-cd "//in"
				MEGAWDIR="//in"
			fi
		elif [[ "$TMENU_RESULT" == "$ESC_KEY"'t' ]]; then
			if [[ "$MEGAWDIR" == '//bin'* ]]; then
				if [[ "$MEGASRC" == '//bin'* || "$MEGASRC" == '//in'* ]]; then
					MEGASRC="/"
				fi
				mega-cd "$MEGASRC"
				MEGAWDIR="$MEGASRC"
			else
				if [[ "$MEGAWDIR" != '//bin'* && "$MEGAWDIR" != '//in'* ]]; then
					MEGASRC="$MEGAWDIR"
				fi
				mega-cd "//bin"
				MEGAWDIR="//bin"
			fi
		elif [[ "$TMENU_RESULT" == "$ESC_KEY"'l' ]]; then
			mega-logout
			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			else
				TMENU_RESULT='MAINMENU'
			fi
		elif [[ "$TMENU_RESULT" == 0 ]]; then
			if [[ "$1" == "megaSlDst" ]]; then
				MEGADST="$(mega-pwd)"
				if [[ "$megauser" == 'Shared Link' ]]; then
					MEGADST="$(sed -E "s|^\/[^/]*\/?|\/|" <<< "$MEGADST")"
				fi
				TMENU_RESULT="$MEGADST"
				break
			elif [[ "$1" == "megaSlFile" ]]; then
				if [[ "$MENU_SELECTED" == '.' ]]; then
					TMENU_RESULT="$MEGAWDIR"
				elif [[ "$MENU_SELECTED" == '..' ]]; then
					TMENU_RESULT="$(sed -E s/^\(.*\)\\/.*/"\1"/ <<< "$MEGAWDIR")"
				else
					TMENU_RESULT="$MEGAWDIR/$MENU_SELECTED"
				fi
				break
			elif [[ "${MEGA_FILE_TYPES[$index]}" == 'd' || "${MEGA_FILE_TYPES[$index]}" == 'dep' ]]; then
				action.megaDir "$MENU_SELECTED"
			else
				action.megaFile "$MENU_SELECTED"
			fi
		elif [[ "$TMENU_RESULT" == "." ]]; then
			action.megaDir "$TMENU_RESULT"
		elif [[ "$TMENU_RESULT" == "${file_list[$index]}" && ( "${MEGA_FILE_TYPES[$index]}" == 'd' || "${MEGA_FILE_TYPES[$index]}" == 'dep' ) ]]; then
			if [[ "$TMENU_RESULT" == '..' && ("$MEGAWDIR" == '//bin' || "$MEGAWDIR" == '//in') ]]; then
				if [[ "$MEGASRC" == '//bin'* || "$MEGASRC" == '//in'* ]]; then
					MEGASRC='/'
				fi
				mega-cd "$MEGASRC"
				MEGAWDIR="$MEGASRC"
			elif [[ "$TMENU_RESULT" == '..' && "$MEGAWDIR" == '/' ]]; then
				continue
			else
				mega-cd "$TMENU_RESULT"
				MEGAWDIR="$(mega-pwd)"
				if [[ "$megauser" == 'Shared Link' ]]; then
					MEGAWDIR="$(sed -E "s|^\/[^/]*\/?|\/|" <<< "$MEGAWDIR")"
				fi
			fi
		elif [[ "$TMENU_RESULT" == "${file_list[$index]}" && ( "${MEGA_FILE_TYPES[$index]}" == 'f' || "${MEGA_FILE_TYPES[$index]}" == 'ep' ) ]]; then
			action.megaFile "$TMENU_RESULT"
		fi
	done

	if [[ "$1" == "megaSlDst" || "$1" == "megaSlFile" ]]; then
		mega-cd "$MEGASRC"
		MEGAWDIR="$MEGASRC"
	fi
	unset MEGA_FILE_TYPES
}

tmenu.parseTCMD() {
	while IFS= read -r line; do
		if [[ -z "$TCMD_SRC" ]]; then
			TCMD_SRC="$line"
		elif [[ -z "$TCMD_DST" ]]; then
			TCMD_DST="${line:0:-1}"
			DST="${line:0:-1}"
		elif [[ -z "$TCMD_ACT" ]]; then
			TCMD_ACT="$line"
		fi
	done < "$1"
	unset IFS
	echo "$(date +"%x %X") :: $TCMD_SRC" >> ~/.tfe_history

	case "$TCMD_ACT" in
		"hash") tmenu.hashCheck "$TCMD_SRC" ;;

		"explorer")
			local srcPath=${TCMD_SRC%/*}
			cd "$srcPath"
			WDIR="$srcPath"
			tmenu.fileExplorer
			;;
	esac
}

# Starting Point (main)
if [[ ! -z "$1" ]]; then
	tmenu.parseTCMD "$1"
fi

until [[ "$TMENU_RESULT" == "EXIT" ]]; do
	clear
	printf "\t\t\033[44m                        \033[0m\n"
	printf "\t\t\033[44m   TERMUX FILE EDITOR   \033[0m\n"
	printf "\t\t\033[44m                        \033[0m\n"
	echo
	echo

	tmenu "1. File explorer" "2. Backup document" "3. Backup snippets" "4. Backup Vim" "5. Vim" "6. Puppet" "7. Sync all" "8. Mega.nz" "9. Exit"

	case "$TMENU_RESULT" in
		"1. File explorer") tmenu.fileExplorer ;;

		"2. Backup document")
			cd "/storage/emulated/0/Documents/"
			read -rn1 -p "(p)ull|(P)ush? (push) " key
			echo

			if [[ -z "$key" || "$key" == "P" ]]; then
				git add .
				git commit -m "update"
				git push
			elif [[ "$key" == "p" ]]; then
				echo
				git pull
			fi
			cd "$WDIR"

			echo
			read -rsn1 -p "Press ESC to exit, other keys to continue..." key
			echo
			echo
			if [[ "$key" == "$ESC_KEY" ]]; then
				exit
			fi
			;;

		"3. Backup snippets")
			cd "$HOME/.config/coc/ultisnips"
			read -rn1 -p "(p)ull|(P)ush? (push) " key
			echo

			if [[ -z "$key" || "$key" == "P" ]]; then
				git add .
				git commit -m "update"
				git push
			elif [[ "$key" == "p" ]]; then
				echo
				git pull
			fi
			cd "$WDIR"

			echo
			read -rsn1 -p "Press ESC to exit, other keys to continue..." key
			echo
			echo
			if [[ "$key" == "$ESC_KEY" ]]; then
				exit
			fi
			;;

		"4. Backup Vim")
			TFE_ERR=()
			rm -rf "$TMPDIR/vim" 2> /dev/null
			runCmd "mkdir -p '$TMPDIR/vim/.config/coc' '$TMPDIR/vim/.vim/plugged/coc.nvim/plugin' '$TMPDIR/vim/bin'"
			runCmd "cp -rf '$HOME/.config/coc/ultisnips' '$TMPDIR/vim/.config/coc'"
			runCmd "cp -rf '$HOME/.vim/plugged/coc.nvim/plugin/coc.vim' '$TMPDIR/vim/.vim/plugged/coc.nvim/plugin'"
			runCmd "find '$HOME/bin' -mindepth 1 -maxdepth 1 ! -name '.git' -a ! -name 'vim.zip' -exec cp -rf '{}' '$TMPDIR/vim/bin' \;"
			runCmd "7zz a -snl -y '/storage/emulated/0/Backup/Apps/vim.zip' '$TMPDIR/vim/.' '$HOME/.termux' '$HOME/.vimrc' '$HOME/.gitconfig' '$HOME/nodemon.json' '$HOME/.bashrc'"
			runCmd "cp -rf '/storage/emulated/0/Backup/Apps/vim.zip' '$HOME/bin'"
			runCmd "rm -rf '$TMPDIR/vim'"
			runCmd "rm -f '$HOME/bin/checksums.sha256' 2> /dev/null"
			runCmd "find '$HOME/bin' -mindepth 1 -name '.git' -prune -o -name 'node_modules' -prune -o -name 'build' -prune -o \( -type f -a ! -name 'checksums.sha256' \) -exec sha256sum '{}' >> '$HOME/bin/checksums.sha256' \;"

			echo
			printf ">>>>>>>>>> \033[44m %s \033[0m <<<<<<<<<<\n" "Git Push Update"
			echo
			read -rep "Message: (cancel) " cMsg
			echo

			if [[ ! -z "$cMsg" ]]; then
				cd "$HOME/bin"
				git add .
				git commit -m "$cMsg"
				runCmd "git push"
				cd "$WDIR"
			else echo "Git push cancelled!"
			fi

			if [[ ${#TFE_ERR[@]} > 0 ]]; then
				echo
				printf "\033[41m%s\033[93m%s\033[0m\033[41m%s\033[0m\n" "Total " "${#TFE_ERR[@]}" " error when backup:"
				for errCmd in "${TFE_ERR[@]}"; do
					[[ $errCmd =~ (^[a-zA-Z0-9]+)" "(.*) ]]
					cmd="${BASH_REMATCH[1]}"
					params="${BASH_REMATCH[2]}"
					if [[ ${#params} -gt 40 ]]; then
						params="${params:0:26}... ${params: -10}"
					fi
					printf "\t\033[%sm$cmd\033[0m $params\n" $CMD_COLOR
				done
			fi
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"5. Vim") vim ;;

		"6. Puppet")
			cd "/data/data/com.termux/files/home/dev/nodejs/message_spreader"
			PUPPET=1 node index.js
			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			cd "$WDIR"
			;;

		"7. Sync all")
			repos=( "/storage/emulated/0/Documents" "$HOME/.config/coc/ultisnips" "$HOME/dev/nodejs/message_spreader" "$HOME/bin" "/storage/emulated/0/AppProjects/android_wallet" )
			for repo in "${repos[@]}"; do
				cd "$repo"
				repoName="${repo##*/}"
				case "$repoName" in
					"bin")
						repoName="tfe"
						;;
				esac
				echo "Pulling \"$repoName\"..."
				git pull
				echo
			done
			for repo in "${repos[@]}"; do
				cd "$repo"
				repoName="${repo##*/}"
				case "$repoName" in
					"bin")
						repoName="tfe"
						;;
				esac
				read -rn1 -p "Push \"$repoName\"? (y/N/c): " key
				echo
				if [[ "$key" == "c" || "$key" == "C" || "$key" == "$ESC_KEY" ]]; then
					cd "$WDIR"
					echo
					exit
				elif [[ "$key" == "y" || "$key" == "Y" ]]; then
					cMsg=""
					case "$repoName" in
						"Documents" | "ultisnips")
							cMsg="update"
							echo
							;;
					
						*)
							read -rep "Message: (cancel) " cMsg
							echo
							;;
					esac
					if [[ ! -z "$cMsg" ]]; then
						git add .
						git commit -m "$cMsg"
						git push
						echo
						read -rsn1 -p "Press ESC to exit, other keys to continue..." key
						echo
						echo
						if [[ "$key" == "$ESC_KEY" ]]; then
							cd "$WDIR"
							exit
						fi
					fi
				fi
			done
			cd "$WDIR"
			;;

		"8. Mega.nz")
			tmenu.megaExplorer
			;;

		"9. Exit" | "0" | "$ESC_KEY") exit ;;
	esac
done

