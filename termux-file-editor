#!/data/data/com.termux/files/usr/bin/bash

source /data/data/com.termux/files/home/bin/tmenu.sh

#			FG(N)	BG(N)	FG(L)	BG(L)
#	Black	30		40		90		100
#	Red		31		41		91		101
#	Green	32		42		92		102
#	Yellow	33		43		93		103
#	Blue	34		44		94		104
#	Magenta	35		45		95		105
#	Cyan	36		46		96		106
#	White	37		47		97		107

WDIR="$(pwd)"
ESC_KEY=$'\033'
ERROR_COLOR=91
CMD_COLOR=96


tmenu.loadConfig() {
	if [[ -d "$HOME/.tfe" ]]; then
		if [[ -f "$HOME/.tfe/config" ]]; then
			prevIFS="$IFS"
			while IFS= read -r line; do
				local configName="$(grep -Eo "^[^:]+" <<< "$line")"
				local configValue="$(sed -E s/"$configName: "// <<< "$line" | sed -E "s/\|[^|]*$//")"
				local configExtraValue=""
				if [[ "$line" =~ '|'[^|]+$ ]]; then
					configExtraValue="$(grep -Eo "[^|]+$" <<< "$line")"
				fi
				case "$configName" in
					"megaLoginUser")
						megaLoginUser="$configValue"
						;;

					"megaLoginLink")
						megaLoginLink="$configValue"
						megaLoginLinkDirName="$configExtraValue"
						;;
				esac
			done < "$HOME/.tfe/config"
			IFS="$prevIFS"
		else
			echo
			local msg="File \033[1;31m%s\033[0m not found.\n"
			printf "$msg" "config"
			read -rn1 -p "Create new one? (Y/n): " key

			if [[ -z "$key" || "$key" == "y" || "$key" == "Y" ]]; then
				echo "srcDir: $HOME" > "$HOME/.tfe/config"
				echo "dstDir: $HOME" >> "$HOME/.tfe/config"
				echo "megaSrcDir: /" >> "$HOME/.tfe/config"
				echo "megaDstDir: /" >> "$HOME/.tfe/config"
				echo "megaLoginUser: null" >> "$HOME/.tfe/config"
				echo "megaLoginLink: null" >> "$HOME/.tfe/config"
			fi
		fi
	else
		mkdir "$HOME/.tfe"
		echo "srcDir: $HOME" > "$HOME/.tfe/config"
		echo "dstDir: $HOME" >> "$HOME/.tfe/config"
		echo "megaSrcDir: /" >> "$HOME/.tfe/config"
		echo "megaDstDir: /" >> "$HOME/.tfe/config"
		echo "megaLoginUser: null" >> "$HOME/.tfe/config"
		echo "megaLoginLink: null" >> "$HOME/.tfe/config"
	fi
}

tmenu.loadConfig

tmenu.hashCheck() {
	declare -a hashMenu

	until [[ "$TMENU_RESULT" == "EXIT" ]]; do
		clear
		printf "\033[47m\033[30m HASH check \033[0m\n------------\n\n"

		hashMenu=( "1. SHA1" "2. SHA256" "3. SHA384" "4. SHA512" "5. MD5" "6. Back" )

		tmenu "${hashMenu[@]}"

		case "$TMENU_RESULT" in
			"1. SHA1")
				echo === SHA1 ===
				sha1sum "$1"
				echo
				read -rsn1 -p "Press ESC to exit, other keys to continue..." key
				echo
				echo
				if [[ "$key" == "$ESC_KEY" ]]; then
					exit
				fi
				;;

			"2. SHA256")
				echo === SHA256 ===
				sha256sum "$1"
				echo
				read -rsn1 -p "Press ESC to exit, other keys to continue..." key
				echo
				echo
				if [[ "$key" == "$ESC_KEY" ]]; then
					exit
				fi
				;;
			
			"3. SHA384")
				echo === SHA384 ===
				sha384sum "$1"
				echo
				read -rsn1 -p "Press ESC to exit, other keys to continue..." key
				echo
				echo
				if [[ "$key" == "$ESC_KEY" ]]; then
					exit
				fi
				;;
			
			"4. SHA512")
				echo === SHA512 ===
				sha512sum "$1"
				echo
				read -rsn1 -p "Press ESC to exit, other keys to continue..." key
				echo
				echo
				if [[ "$key" == "$ESC_KEY" ]]; then
					exit
				fi
				;;
			
			"5. MD5")
				echo === MD5 ===
				md5sum "$1"
				echo
				read -rsn1 -p "Press ESC to exit, other keys to continue..." key
				echo
				echo
				if [[ "$key" == "$ESC_KEY" ]]; then
					exit
				fi
				;;

			"6. Back" | "0" | "$ESC_KEY")
				unset TMENU_RESULT
				break
				;;
		esac
	done
}

runCmd() {
	eval "$1"
	if [[ $? -ne 0 ]]; then
		TFE_ERR+=( "$1" )
	fi
}

list() {
	ListArray+=( "$1" )
}

checkRootDir() {
	local isRootDir=1
	local fileCounter=0
	for file in "$1"/*; do
		if [[ ! -d "$file" ]]; then
			(( ++fileCounter ))
		fi
		if [[ ! -d "$file" && "$1/checksums.sha256" != "$file" ]]; then
			isRootDir=0
			break
		fi
	done
	if [[ $fileCounter -eq 0 ]]; then
		isRootDir=0
	fi
	return $isRootDir
}

action.dir() {
	local title="\033[44m Directory Action \033[0m\n\033[44m ---------------- \033[0m\n\n"
	printf "$title"

	declare -a actions

	if [[ ! -z "$DST" ]]; then
		local prevDST="$(basename "$DST")"
		actions+=( "Copy to \"$prevDST\"" )
	fi

	actions+=( "Copy" )

	if [[ ! -z "$DST" ]]; then
		actions+=( "Move to \"$prevDST\"" )
	fi

	actions+=( "Move" "Delete" "Rename" "New folder" "New file" "Create checksums" "Upload to Mega.nz" )

	if [[ -f "$1/checksums.sha256" ]]; then
		actions+=( "Checksums" )
	fi

	if [[ -d "$1/.git" ]]; then
		actions+=( "Git" )
	fi

	for file in "$1"/*.deb; do
		if [[ -f "$file" ]]; then
			actions+=( "Install" )
			break
		fi
	done

	checkRootDir "$1"
	if [[ $? -eq 1 ]]; then
		actions+=( "Install all" )
	fi

	actions+=( "Magick" )
	if [[ -f "$1/package.json" ]]; then
		actions+=( "Install Node.js" )
	fi
	actions+=( "Zip" )
	if [[ ! -z "$DST" ]]; then
		actions+=( "Zip to \"$prevDST\"" )
	fi
	actions+=( "Detail" )

	tmenu "${actions[@]}"

	case "$TMENU_RESULT" in
		"Copy to \"$prevDST\"")
			cp -rf "./$1" "$DST"
			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Copy")
			tmenu.fileExplorer "slDst"
			if [[ "$TMENU_RESULT" == "$ESC_KEY" ]]; then
				local cDST=""
				read -rep "Destination: (cancel) " cDST
				echo
				eval cDST="$cDST"
				if [[ ! -z "$cDST" ]]; then
					cp -rf "./$1" "$cDST"
				fi
			else
				cp -rf "./$1" "$DST"
			fi

			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Move to \"$prevDST\"")
			if [[ "$1" == "." ]]; then
				local currentDir="$(basename "$WDIR")"
				cd ..
				WDIR="$(pwd)"
				mv "$currentDir" "$DST"
			else
				mv "./$1" "$DST"
			fi
			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Move")
			tmenu.fileExplorer "slDst"
			local mDST=""
			if [[ "$TMENU_RESULT" == "$ESC_KEY" ]]; then
				read -rep "Destination: (cancel) " iDST
				echo
				eval iDST="$iDST"
				if [[ ! -z "$iDST" ]]; then
					mDST="$iDST"
				fi
			else
				mDST="$DST"
			fi
			if [[ "$1" == "." ]]; then
				local currentDir="$(basename "$WDIR")"
				cd ..
				WDIR="$(pwd)"
				mv "$currentDir" "$mDST"
			else
				mv "./$1" "$mDST"
			fi

			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Delete")
			local dotOpt=""
			local msg="Delete \033[1;31m%s\033[0m? (y/N): "
			local itemDelete=""
			if [[ "$1" == "." ]]; then
				itemDelete='**All**'
			else itemDelete="$1"
			fi

			printf "$msg" "$itemDelete"
			read -rn1 key
			echo
			echo

			if [[ "$key" == "y" || "$key" == "Y" ]]; then
				if [[ "$1" == "." ]]; then
          			dotOpt=$(shopt -p dotglob)
          			dotOpt=${dotOpt:7:1}
					if [[ "$dotOpt" == "u" ]]; then
						shopt -s dotglob
						rm -rf ./*
					else rm -rf ./*
					fi
				else rm -rf "./$1"
				fi

				if [[ $? -ne 0 ]]; then
					echo
					read -rsn1 -p "Press any key to continue..." key
				else unset prevItem
				fi

				if [[ "$dotOpt" == "u" ]]; then
					shopt -u dotglob
				fi
			fi
			;;

		"Rename")
			local newName=""
			read -rep "New name: (cancel) " newName
			echo
			eval newName="$newName"
			if [[ ! -z "$newName" ]]; then
				mv "./$1" "$newName"
			fi

			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"New folder")
			local fName=""
			read -rep "Folder name: (cancel) " fName
			echo
			eval fName="$fName"
			if [[ ! -z "$fName" ]]; then
				mkdir "$1/$fName"
			fi

			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"New file")
			local fName=""
			read -rep "File name: (cancel) " fName
			echo
			eval fName="$fName"
			if [[ ! -z "$fName" ]]; then
				cd "$1"
				touch "$fName"
				cd "$WDIR"
			fi

			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Create checksums")
			cd "$1"
			rm -f checksums.sha256 2> /dev/null
			find . -mindepth 1 -name '.git' -prune -o -name 'node_modules' -prune -o -name 'build' -prune -o \( -type f -a ! -name 'checksums.sha256' \) -exec sha256sum '{}' >> checksums.sha256 \;
			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			cd "$WDIR"
			;;

		"Upload to Mega.nz")
			local srcPath=""
			if [[ "$1" == '.' ]]; then
				srcPath="$WDIR"
			elif [[ "$1" == '..' ]]; then
				srcPath="$(sed -E s/^\(.*\)\\/.*/"\1"/ <<< "$WDIR")"
			else
				srcPath="$WDIR/$1"
			fi

			tmenu.megaExplorer "megaSlDst"
			if [[ $? -eq 0 ]]; then
				if [[ "$TMENU_RESULT" != "$ESC_KEY" ]]; then
					mega-put "$srcPath" "$TMENU_RESULT"
					echo
					read -rsn1 -p "Press any key to continue..." key
				fi
			fi
			;;

		"Checksums")
			cd "$1"
			sha256sum -c "checksums.sha256" 1> /dev/null
			if [[ $? -eq 0 ]]; then
				echo "All files checked OK."
			fi
			echo
			read -rsn1 -p "Press any key to continue..." key
			cd "$WDIR"
			;;

		"Git")
			local cMsg=""
			cd "$1"
			read -rn1 -p "(p)ull|(P)ush|(c)heckout? (push) " key
			echo

			if [[ -z "$key" || "$key" == "P" ]]; then
				read -rep "Message: (cancel) " cMsg
				echo
				if [[ ! -z "$cMsg" ]]; then
					git add .
					git commit -m "$cMsg"
					git push
					echo
					read -rsn1 -p "Press any key to continue..." key
				fi
			elif [[ "$key" == "p" ]]; then
				echo
				git pull
				echo
				read -rsn1 -p "Press any key to continue..." key
			elif [[ "$key" == "c" ]]; then
				read -rep "Branch|File name: (cancel) " check
				echo
				if [[ ! -z "$check" ]]; then
					git checkout "$check"
					echo
					read -rsn1 -p "Press any key to continue..." key
				fi
			fi

			cd "$WDIR"
			;;

		"Install")
			cd "$1"
			dpkg -i *.deb
			echo
			read -rsn1 -p "Press any key to continue..." key
			cd "$WDIR"
			;;

		"Install all")
			cd "$1"
			dpkg -i -R .
			echo
			read -rsn1 -p "Press any key to continue..." key
			cd "$WDIR"
			;;

		"Magick")
			local zDst
			local pDir=".."
			local zName="$1"
			if [[ "$1" == "." ]]; then
				zName="${WDIR##*/}"
				pDir="."
			fi
			echo "Resample *.jpg and create archive \"${zName}.zip\"?"
			read -rn1 -p "(p)ath|(c)ancel: (ok) " key
			echo
			if [[ -z "$key" ]]; then
				mkdir "$1/$zName"
				magick mogrify -identify -path "$1/$zName" -resample 10% "$1/*.jpg"
				cd "$1"
				7zz a -snl "$pDir/${zName}.zip" "$zName/."
				rm -rf "$zName"
				cd "$pDir"
				echo
				read -rn1 -p "Move zipped to \"Upload\"? (ok) " key
				if [[ -z "$key" ]]; then
					mv "${zName}.zip" "/storage/emulated/0/Upload"
				fi
			elif [[ "$key" == "p" || "$key" == "P" ]]; then
				read -rep "Archive path/name: " zDst
				echo
				eval zDst="$zDst"
				mkdir "$1/$zName"
				magick mogrify -identify -path "$1/$zName" -resample 10% "$1/*.jpg"
				cd "$1"
				if [[ "$zDst" != *"/"* || "$zDst" == "./"* || "$zDst" == "../"* ]]; then
					7zz a -snl "$pDir/$zDst" "$zName/."
				else 7zz a -snl "$zDst" "$zName/."
				fi
				rm -rf "$zName"
				echo
				read -rn1 -p "Move zipped to \"Upload\"? (ok) " key
				if [[ -z "$key" ]]; then
					if [[ "$zDst" != *"/"* || "$zDst" == "./"* || "$zDst" == "../"* ]]; then
						mv "$pDir/$zDst" "/storage/emulated/0/Upload"
					else mv "$zDst" "/storage/emulated/0/Upload"
					fi
				fi
				cd "$pDir"
			else return
			fi
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Install Node.js")
			cd "$1"
			npm install
			cd "$WDIR"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Zip")
			local zDst
			local zName="$1.zip"
			if [[ "$1" == "." ]]; then
				zName="${WDIR##*/}.zip"
			fi
			echo "Create archive \"$zName\"?"
			read -rn1 -p "(p)ath|(c)ancel: (ok) " key
			if [[ -z "$key" ]]; then
				7zz a -snl "$zName" "$1"
			elif [[ "$key" == "p" || "$key" == "P" ]]; then
				echo
				read -rep "Archive path/name: " zDst
				eval zDst="$zDst"
				7zz a -snl "$zDst" "$1"
			else return
			fi
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Zip to \"$prevDST\"")
			local aName="$1"
			if [[ "$aName" == "." ]]; then
				aName="$(basename "$WDIR")"
			fi
			7zz a -snl "$DST/$aName.zip" "$1"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Detail")
			echo "Directory Detail"
			echo "----------------"
			echo
			echo "Size: $(du -sh "$1")"
			echo
			ls -lh "$1"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;
	esac
}

action.file() {
	declare -a actions
	local dir="$WDIR"

	local title="\033[44m File Action \033[0m\n\033[44m ----------- \033[0m\n\n"
	printf "$title"

	if [[ ! -z "$DST" ]]; then
		local prevDST="$(basename "$DST")"
		actions+=( "Copy to \"$prevDST\"" )
	fi

	actions+=( "Copy" )

	if [[ ! -z "$DST" ]]; then
		actions+=( "Move to \"$prevDST\"" )
	fi

	actions+=( "Move" "Delete" "Rename" "Edit" "Hash check" "Upload to Mega.nz" )

	if [[ "$1" == "checksums.sha256" ]]; then
		actions+=( "Checksums" )
	fi

	while [[ ! -z "$dir" ]]; do
		if [[ -r "$dir" ]]; then
			if [[ -d "$dir/.git" ]]; then
				actions+=( "Git checkout" )
				break
			else
				dir="${dir%/*}"
			fi
		else break
		fi
	done

	if [[ -x "$1" ]]; then
		actions+=( "Run" )
	fi

	case "$1" in
		*".deb")
			actions+=( "Install" )
			;;

		*".zip"|*".7z"|*".gz"|*".xz"|*".tar"|*".rar")
			actions+=( "Extract" )
			;;

		*".sh")
			if [[ ! -x "$1" ]]; then
				actions+=( "Run Shell" )
			fi
			;;

		*".js"|*".cjs"|*".mjs")
			actions+=( "Run Node.js" "Run NodeMon" )
			;;

		*".class")
			actions+=( "Run Java" )
			;;

		*".java")
			actions+=( "Compile Java" )
			;;

		*".txt")
			actions+=( "to JSON" )
			;;
	esac

	actions+=( "Detail" )

	tmenu "${actions[@]}"

	case "$TMENU_RESULT" in
		"Copy to \"$prevDST\"")
			cp -f "./$1" "$DST"
			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Copy")
			local cDST=""
			tmenu.fileExplorer "slDst"
			if [[ "$TMENU_RESULT" == "$ESC_KEY" ]]; then
				read -rep "Destination: (cancel) " cDST
				echo
				eval cDST="$cDST"
				if [[ ! -z "$cDST" ]]; then
					cp -f "./$1" "$cDST"
				fi
			else
				cp -f "./$1" "$DST"
			fi

			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Move to \"$prevDST\"")
			mv "./$1" "$DST"
			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Move")
			tmenu.fileExplorer "slDst"
			if [[ "$TMENU_RESULT" == "$ESC_KEY" ]]; then
				local mDST=""
				read -rep "Destination: (cancel) " mDST
				echo
				eval mDST="$mDST"
				if [[ ! -z "$mDST" ]]; then
					mv "./$1" "$mDST"
				fi
			else
				mv "./$1" "$DST"
			fi

			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Delete")
			local msg="Delete \033[1;31m%s\033[0m? (y/N): "
			printf "$msg" "$1"
			read -rn1 key
			echo
			echo

			if [[ "$key" == "y" || "$key" == "Y" ]]; then
				rm -f "./$1"
				if [[ $? -ne 0 ]]; then
					echo
					read -rsn1 -p "Press any key to continue..." key
				else unset prevItem
				fi
			fi
			;;

		"Rename")
			local newName=""
			read -rep "New name: (cancel) " newName
			echo
			eval newName="$newName"
			if [[ ! -z "$newName" ]]; then
				mv "./$1" "$newName"
			fi

			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Edit")
			vim "$1"
			;;

		"Hash check")
			tmenu.hashCheck "$1"
			;;

		"Upload to Mega.nz")
			tmenu.megaExplorer "megaSlDst"
			if [[ $? -eq 0 ]]; then
				if [[ "$TMENU_RESULT" != "$ESC_KEY" ]]; then
					mega-put "$1" "$TMENU_RESULT"
					echo
					read -rsn1 -p "Press any key to continue..." key
				fi
			fi
			;;

		"Checksums")
			sha256sum -c "checksums.sha256" 1> /dev/null
			if [[ $? -eq 0 ]]; then
				echo "All files checked OK."
			fi
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Git checkout")
			read -rn1 -p "Recover \"$1\"? (y/N): " key
			echo
			if [[ "$key" == "y" || "$key" == "Y" ]]; then
				git checkout "$1"
			fi
			;;

		"Run")
			"./$1"
			;;

		"Install")
			dpkg -i $1
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Extract")
			local zDst
			read -rep "Destination: " zDst
			eval zDst="$zDst"
			7zz x -o"$zDst" "$1"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Run Shell")
			bash "$1"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Run Node.js")
			node "$1"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Run NodeMon")
			nodemon "$1"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Run Java")
			java "${1:0: -6}"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Compile Java")
			javac "$1" && java "${1:0: -5}"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"to JSON")
			local fName="${1:0:-3}json"
			local firstLine=""
			while IFS= read -r line; do
				if [[ -z "$firstLine" ]]; then
					if [[ ! -z "$line" ]]; then
						printf "[\n\t\"$line\"" >> "$fName"
						firstLine="$line"
					fi
				elif [[ ! -z "$line" ]]; then
					printf ",\n\t\"$line\"" >> "$fName"
				fi
			done < "$1"
			if [[ ! -z "$firstLine" ]]; then
				printf "\n]\n\n" >> "$fName"
			fi
			unset IFS
			;;

		"Detail")
			echo "File Detail"
			echo "----------------"
			echo
			echo "Size: $(du -sh "$1")"
			echo
			ls -lh "$1"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;
	esac
}

tmenu.fileExplorer() {
	SRC="$(pwd)"
	local title=""
	local prevItem=""
	unset MEGA_FILE_TYPES

	until [[ "$TMENU_RESULT" == "EXIT" ]]; do
		clear
		local file_list=( "." ".." )
		local checkPrev=0
		local numDir=0
		local numFile=0

		for file in *; do
			if [[ -d "$file" ]]; then
				file_list+=( "$file" )
				(( ++numDir ))
			fi
			if [[ "$prevItem" == "$file" ]]; then
				checkPrev=1
			fi
		done

		for file in *; do
			if [[ -f "$file" ]]; then
				file_list+=( "$file" )
				(( ++numFile ))
			fi
		done

		if [[ -z "$1" ]]; then
			title="\033[44m FILE EXPLORER \033[0m\n\033[44m ------------- \033[0m\n\n[D:\033[1;34m$numDir\033[0m | F:\033[1;33m$numFile\033[0m] \033[1;36m$(pwd)\033[0m\n(0: Action | 1: Directory)\n\n"
		elif [[ "$1" == "slDst" ]]; then
			title="\033[46m SELECT DESTINATION \033[0m\n\033[46m ------------------ \033[0m\n\n[D:\033[1;34m$numDir\033[0m | F:\033[1;33m$numFile\033[0m] \033[1;36m$(pwd)\033[0m\n(0: Select)\n\n"
		elif [[ "$1" == "slFile" ]]; then
			title="\033[46m SELECT FILE/FOLDER \033[0m\n\033[46m ------------------ \033[0m\n\n[D:\033[1;34m$numDir\033[0m | F:\033[1;33m$numFile\033[0m] \033[1;36m$(pwd)\033[0m\n(0: Select)\n\n"
		fi

		printf "$title"

		if [[ -z "$prevItem" || ! -z "$prevItem" && $checkPrev == 0 ]]; then
			if [[ ! -z "${file_list[2]}" ]]; then
				prevItem=${file_list[2]}
			else
				prevItem=".."
			fi
		fi
		
		tmenu "$prevItem" "${file_list[@]}"
		
		prevItem="$MENU_SELECTED"

		if [[ "$TMENU_RESULT" == "$ESC_KEY" ]]; then
			break
		elif [[ "$TMENU_RESULT" == 0 ]]; then
			if [[ "$1" == "slDst" ]]; then
				DST="$(pwd)"
				TMENU_RESULT="$DST"
				break
			elif [[ "$1" == "slFile" ]]; then
				if [[ "$MENU_SELECTED" == '.' ]]; then
					TMENU_RESULT="$WDIR"
				elif [[ "$MENU_SELECTED" == '..' ]]; then
					TMENU_RESULT="$(sed -E s/^\(.*\)\\/.*/"\1"/ <<< "$WDIR")"
				else
					TMENU_RESULT="$WDIR/$MENU_SELECTED"
				fi
				break
			elif [[ -d "$MENU_SELECTED" ]]; then
				action.dir "$MENU_SELECTED"
			else
				action.file "$MENU_SELECTED"
			fi
		elif [[ "$TMENU_RESULT" == "." ]]; then
			action.dir "$TMENU_RESULT"
		elif [[ -d "$TMENU_RESULT" ]]; then
			cd "$TMENU_RESULT" 
			WDIR="$(pwd)"
			if [[ -z "$1" ]]; then
				SRC="$(pwd)"
			fi
			unset prevItem
		elif [[ -f "$TMENU_RESULT" ]]; then
			action.file "$TMENU_RESULT"
		fi
	done
	if [[ "$1" == "slDst" || "$1" == "slFile" ]]; then
		cd "$SRC"
		WDIR="$SRC"
	fi
}

megaLogin() {
	tmenu.loadConfig
	mega-session &> /dev/null
	if [[ $? -eq 0 ]]; then
		megauser="$(mega-whoami 2> /dev/null)"
		if [[ $? -eq 0 ]]; then
			megauser=${megauser#Account e-mail: }
		else
			megauser='Shared Link'
		fi
		return 0
	fi

	until [[ "$TMENU_RESULT" == 'EXIT' || "$TMENU_RESULT" == 'MAINMENU' ]]; do
		clear
		local title="\033[41m #### MEGA LOGIN #### \033[0m\n\033[41m -------------------- \033[0m\n\n"
		printf "$title"
		local loginMethods=( "Email and Password" "Shared Link" "Session ID" "____________________" "" "Create account" )
		unset MEGA_FILE_TYPES
		tmenu "${loginMethods[@]}"

		case "$TMENU_RESULT" in
			"$ESC_KEY")
				return -1
				;;

			"Email and Password")
				local megaLoginName="new"
				if [[ ! -z "$megaLoginUser" && "$megaLoginUser" != "null" ]]; then
					megaLoginName="$(grep -Eo "^[^@]+" <<< "$megaLoginUser")"
				fi

				read -rep $'Username: (c)ancel/(\033[1;32m'"$megaLoginName"$'\033[0m) ' megauser
				if [[ "$megauser" == 'c' || "$megauser" == 'C' || ("$megaLoginName" == 'new' && -z "$megauser") ]]; then
					continue
				fi

				read -rsep "Password: " megapass
				read -rep "2FA code: (none) " mega2fa
				echo

				if [[ -z "$megauser" && "$megaLoginName" != 'new' ]]; then
					megauser="$megaLoginUser"
				fi

				if [[ -z "$mega2fa" ]]; then
					mega-login "$megauser" "$megapass"
				else
					mega-login --auth-code="$mega2fa" "$megauser" "$megapass"
				fi

				if [[ $? -ne 0 ]]; then
					echo
					read -rsn1 -p "Press any key to continue..." key
				else
					sed -Ei s/"^(megaLoginUser: ).*"/"\1$megauser"/ "$HOME/.tfe/config"
					break
				fi
				;;

			"Shared Link")
				local megaLinkDirName=""
				local megaShortLink="new"

				if [[ ! -z "$megaLoginLinkDirName" ]]; then
					megaLinkDirName="$megaLoginLinkDirName"
				fi

				if [[ ! -z "$megaLoginLink" && "$megaLoginLink" != "null" ]]; then
					megaShortLink="$(grep -Eo "^.{12}" <<< "$megaLoginLink")...$(grep -Eo ".{5}$" <<< "$megaLoginLink")"
				fi

				local msg=""
				if [[ -z "$megaLinkDirName" ]]; then
					msg=$'Shared link: (c)ancel/(\033[1;36m'"$megaShortLink"$'\033[0m) '
				else
					msg=$'Shared link: (c)ancel/(\033[1;34m'"$megaLinkDirName"$'\033[0m | \033[1;36m'"$megaShortLink"$'\033[0m) '
				fi

				read -rep "$msg" megaLink
				if [[ "$megaLink" == 'c' || "$megaLink" == 'C' || ("$megaShortLink" == 'new' && -z "$megaLink") ]]; then
					continue
				fi

				if [[ -z "$megaLink" && "$megaShortLink" != 'new' ]]; then
					megaLink="$megaLoginLink"
				fi
				read -rep "Auth Key: (none) " authKey
				echo

				if [[ -z "$authKey" ]]; then
					mega-login "$megaLink"
				else
					mega-login "$megaLink" --auth-key="$authKey"
				fi

				if [[ $? -ne 0 ]]; then
					echo
					read -rsn1 -p "Press any key to continue..." key
				else
					megauser='Shared Link'
					megaLinkDirName="$(basename "$(mega-pwd)")"
					sed -Ei "s|^(megaLoginLink: ).*|\1$megaLink\|$megaLinkDirName|" "$HOME/.tfe/config"
					break
				fi
				;;

			"Session ID")
				read -rep "Session ID: (cancel) " loginSession
				echo
				if [[ -z "$loginSession" || "$loginSession" == 'c' || "$loginSession" == 'C' ]]; then
					continue
				fi
				mega-login "$loginSession"

				if [[ $? -ne 0 ]]; then
					echo
					read -rsn1 -p "Press any key to continue..." key
				else
					megauser="$(mega-whoami 2> /dev/null)"
					if [[ $? -eq 0 ]]; then
						megauser=${megauser#Account e-mail: }
					else
						megauser='Shared Link'
					fi
					break
				fi
				;;

			"Create account")
				local username
				local password
				local passwordValidate
				local accountname

				read -rep "Username (email): (cancel) " username
				if [[ -z "$username" || "$username" == 'c' || "$username" == 'C' ]]; then
					continue
				fi

				while :; do
					read -rsep "Password: " password
					read -rsep "Retype password: " passwordValidate

					if [[ -z "$password" || -z "$passwordValidate" ]]; then
						echo
						printf "\033[1;31m%s\033[0m\n" "Password must not null."
						echo
						read -rsn1 -p "Press any key to continue..." key
						echo
						printf "\033[6A\033[0J"
					elif [[ "$password" != "$passwordValidate" ]]; then
						echo
						printf "\033[1;31m%s\033[0m\n" "Password didn't match."
						echo
						read -rsn1 -p "Press any key to continue..." key
						echo
						printf "\033[6A\033[0J"
					else
						break
					fi
				done

				read -rep "Account name: " accountname
				echo

				mega-signup "$username" "$password" --name="$accountname"

				if [[ $? -ne 0 ]]; then
					echo
					read -rsn1 -p "Press any key to continue..." key
				else
					echo
					printf "\033[1;32m%s\033[0m\n" "Account created successfully."
					printf "Please check your email \033[1;36m%s\033[0m to verify.\n" "$username"
					echo
					read -rep "Link verify: (cancel) " linkVerify
					echo
					if [[ ! -z "$linkVerify" ]]; then
						local verifyResult="$(mega-confirm "$linkVerify" "$username" "$password")"
						if [[ $? -eq 0 ]]; then
							printf "$(sed -E "s/([^ ]+@[^ ]+)/\\\033[1;36m\1\\\033[0m/" <<< "$verifyResult")\n"
						fi
						echo
						read -rsn1 -p "Press any key to continue..." key
					fi
				fi
				;;
		esac
	done
}

getMegaUsedStorage() {
	unset megaUsedStorage
	unset megaUsedInbox
	unset megaUsedTrashBin
	if [[ "$megauser" != 'Shared Link' ]]; then
		megaUsage="$(mega-df -h)"
		megaUsedStorage="$(grep -i 'storage' <<< "$megaUsage" | sed -E s/^.{24}/'Usage: '/ | sed -E s/' '{23}/'  - '/)"
		megaUsedInbox="$(grep -i 'inbox' <<< "$megaUsage" | sed -E s/^.{24}/'Inbox: '/ | sed -E s/' and'//)"
		megaUsedTrashBin="$(grep -i 'rubbish' <<< "$megaUsage" | sed -E s/^.{24}/'Trash: '/ | sed -E s/' and'//)"
	else
		megaUsedStorage="$(mega-pwd | sed -E "s|^\/([^/]*).*|\1|")"
	fi
}

action.megaFind() {
	local pattern
	local msg="Find: "
	if [[ "$1" == '/' || "$1" == '.' && "$MEGAWDIR" == '/' ]]; then
		msg="Root find: "
	fi
	read -rep "$msg" pattern

	if [[ ! -z "$pattern" ]]; then
		local findResult="$(mega-find "$1" -l --pattern="*$pattern*" --show-handles)"
		echo
		if [[ -z "$findResult" ]]; then
			printf "\033[1;31m%s\033[0m\n" "Pattern not found."
		else
			local totalResult="$(grep -c "." <<< "$findResult")"
			printf "Total found: \033[1;32m%s\033[0m\n\n" "$totalResult"

			local prevIFS="$IFS"
			while IFS= read -r line; do
				local filePath="$(sed -E "s|^(.+) <[a-zA-Z]:[^ ]+.*|\1|" <<< "$line")"
				local parentPath="$(grep -Eo "^.*/" <<< "$filePath")"
				local fileName="$(grep -Eo "[^/]+$" <<< "$filePath")"
				local fileHandle="$(sed -E "s|^.+ <([a-zA-Z]:[^> ]+).*|\1|" <<< "$line")"
				grep -Eio "[a-zA-Z]:[^ ]+ \(folder" <<< "$line" &> /dev/null
				if [[ $? -eq 0 ]]; then
					filePath="\033[44m$parentPath$(sed -E "s|$pattern|\\\033[1;31m$pattern\\\033[0m\\\033[44m|g" <<< "$fileName")\033[0m"
					printf "$filePath $fileHandle\n"
				else
					filePath="$parentPath$(sed -E "s|$pattern|\\\033[1;31m$pattern\\\033[0m|g" <<< "$fileName")"
					local fileSize="$(sed -E "s|^.+ <[a-zA-Z]:[^ ]+ \(([^),]+).*|\1|" <<< "$line")"
					printf "$filePath $fileHandle $fileSize\n"
				fi

				local fileSharedLink="$(grep -Eio 'https://[^) ]+' <<< "$line")"
				if [[ ! -z "$fileSharedLink" ]]; then
					local authToken="$(grep -Eio 'AuthToken=[^)]+' <<< "$line" | sed -E s/'^AuthToken='//)"
					if [[ -z "$authToken" ]]; then
						printf "\033[1;36m%s\033[0m\n\n" "$fileSharedLink"
					else
						authToken="AuthToken: $(grep -Eio "^.+:" <<< "$authToken")\033[1;31m$(sed -E s/'^.+:'// <<< "$authToken")\033[0m"
						printf "\033[1;36m%s\033[0m\n$authToken\n\n" "$fileSharedLink"
					fi
				fi
			done <<< "$findResult"
			IFS="$prevIFS"
		fi

		echo
		read -rsn1 -p "Press any key to continue..." key
	fi
}

action.megaContact() {
	until [[ "$TMENU_RESULT" == 'EXIT' || "$TMENU_RESULT" == 'MAINMENU' || "$TMENU_RESULT" == 'EXPLORER' ]]; do
		clear
		local title="\033[41m MEGA CONTACT MANAGER (\033[1;32m%s\033[0m\033[41m) ${lineSpacer:0:$(( ${#lineSpacer} - 25 - ${#megauser} ))}\033[0m\n\033[41m%s\033[0m\n\033[47m\033[1;30m %s ${lineSpacer:0:$(( ${#lineSpacer} - 2 - ${#storageInfo} ))}\033[0m\n\n[D:\033[1;34m%s\033[0m | F:\033[1;33m%s\033[0m] \033[1;36m%s\033[0m\n(Esc+l: Logout | Esc+m: Back)\n\n"
		printf "$title" "$megauser" "$lineSeparator" "$storageInfo" "$numDir" "$numFile" "$MEGAWDIR"

		local menuContacts=( "Add Contact" "Request Pending" )

		local contacts="$(mega-users -sn)"
		local numContact="$(grep -Ec " [^ ]+@[^ ]+\. " <<< "$contacts")"
		local contactsText="Not yet added any contact."

		if [[ ! -z "$contacts" ]]; then
			menuContacts+=( "Delete Contact" "Verify Contact" "Unverify Contact" "Help Verify Contact" )
			contactsText="$(sed -E "s/ ([^ ]+@[^ ]+)\. / \\\033[1;36m\1\\\033[0m\. /g" <<< "$contacts")"
		fi

		local incomingRequest="$(mega-showpcr --in)"
		local outgoingRequest="$(mega-showpcr --out)"
		local numIncomingRequest="$(grep -Ec "^ [^ ]+@[^ ]+" <<< "$incomingRequest")"
		local numOutgoingRequest="$(grep -Ec "^ [^ ]+@[^ ]+" <<< "$outgoingRequest")"

		printf "Contact: \033[1;32m%s\033[0m\tPending: \033[1;31m%s\033[0m\tRequest: \033[1;36m%s\033[0m\n\n$contactsText\n" "$numContact" "$numIncomingRequest" "$numOutgoingRequest"
		echo

		unset MEGA_FILE_TYPES
		tmenu "${menuContacts[@]}"

		case "$TMENU_RESULT" in
			"$ESC_KEY" | "$ESC_KEY"'m')
				break
				;;

			"$ESC_KEY"'q')
				TMENU_RESULT='MAINMENU'
				;;

			"$ESC_KEY"'e')
				TMENU_RESULT='EXIT'
				;;

			"$ESC_KEY"'l')
				mega-logout
				if [[ $? -ne 0 ]]; then
					echo
					read -rsn1 -p "Press any key to continue..." key
				else
					TMENU_RESULT='MAINMENU'
				fi
				;;

			"Add Contact")
				local contactEmail=""
				local message=""
				read -rep "Contact email: (cancel) " contactEmail
				if [[ ! -z "$contactEmail" ]]; then
					read -rep $'Message: (Request sending by \033[1;32m'"$megauser"$'\033[0m) ' message
					echo

					if [[ -z "$message" ]]; then
						message="Request sending by $megauser"
					fi
					mega-invite "$contactEmail" --message="$message" 1> /dev/null

					if [[ $? -eq 0 ]]; then
						printf "Invitation to \033[1;36m%s\033[0m has been send.\nPlease contact the user to confirm.\n" "$contactEmail"
					fi

					echo
					read -rsn1 -p "Press any key to continue..." key
				fi
				;;

			"Request Pending")
				until [[ "$TMENU_RESULT" == 'EXIT' || "$TMENU_RESULT" == 'MAINMENU' || "$TMENU_RESULT" == 'EXPLORER' ]]; do
					local requestPending="$(mega-showpcr)"
					if [[ ! -z "$requestPending" ]]; then
						local incomingRequest="$(mega-showpcr --in)"
						local outgoingRequest="$(mega-showpcr --out)"
						local numRequest="$(grep -Ec "^ [^ ]+@[^ ]+" <<< "$requestPending")"
						local numIncomingRequest="$(grep -Ec "^ [^ ]+@[^ ]+" <<< "$incomingRequest")"
						local numOutgoingRequest="$(grep -Ec "^ [^ ]+@[^ ]+" <<< "$outgoingRequest")"
						printf "Total: \033[1;32m%s\033[0m      Incoming: \033[1;31m%s\033[0m      Outgoing: \033[1;36m%s\033[0m\n\n" "$numRequest" "$numIncomingRequest" "$numOutgoingRequest"
						local formatedRequest="$(sed -E "s/^ ([^ ]+@[^ ]+)/\\\033[1;36m\1\\\033[0m/g" <<< "$requestPending")"
						formatedRequest="$(sed -E "s/(Outgoing PCRs:)/\\\033[42m \1 \\\033[0m/" <<< "$formatedRequest")"
						if [[ -z "$outgoingRequest" ]]; then
							formatedRequest="$(sed -E "s/(Incoming PCRs:)/\\\033[42m \1 \\\033[0m/" <<< "$formatedRequest")"
						else
							formatedRequest="$(sed -E "s/(Incoming PCRs:)/\n\\\033[42m \1 \\\033[0m/" <<< "$formatedRequest")"
						fi
						printf "$formatedRequest\n"
						echo

						local pendingActions=()
						if [[ ! -z "$incomingRequest" ]]; then
							pendingActions+=( "Process Incoming Request" )
						fi

						if [[ ! -z "$outgoingRequest" ]]; then
							pendingActions+=( "Process Outgoing Request" )
						fi

						tmenu "${pendingActions[@]}"

						case "$TMENU_RESULT" in
							"$ESC_KEY")
								break
								;;

							"$ESC_KEY"'m')
								TMENU_RESULT='EXPLORER'
								;;

							"$ESC_KEY"'l')
								mega-logout
								if [[ $? -ne 0 ]]; then
									echo
									read -rsn1 -p "Press any key to continue..." key
								else
									TMENU_RESULT='MAINMENU'
								fi
								;;

							"Process Incoming Request")
								printf "\033[$(( ${#pendingActions[@]} + 1 ))A\033[0J"
								local incomingEmails=( $(grep -Eo "^ [^ ]+@[^ ]+" <<< "$incomingRequest" | grep -Eo "[^ ]+@[^ ]+") )
								tmenu "${incomingEmails[@]}"

								local incomingEmail=""
								for (( i=0 ; i<${#incomingEmails[@]} ; i++ )); do
									if [[ "$TMENU_RESULT" == "${incomingEmails[$i]}" ]]; then
										incomingEmail="${incomingEmails[$i]}"
										break
									fi
								done

								if [[ ! -z "$incomingEmail" ]]; then
									printf "\033[$(( ${#incomingEmails[@]} + 1 ))A\033[0J"
									local incomingActions=( "Accept Invitation" "Reject Invitation" "Ignore Invitation" )
									tmenu "${incomingActions[@]}"

									case "$TMENU_RESULT" in
										"Accept Invitation")
											local ipcResult="$(mega-ipc "$incomingEmail" -a)"
											ipcResult="$(sed -E "s/([^ ]+@[^ ]+)/\\\033[1;36m\1\\\033[0m/" <<< "$ipcResult")"
											printf "$ipcResult\n"
											echo
											verifyResult="$(mega-users --verify "$incomingEmail" &> /dev/stdout)"
											if [[ $? -eq 0 || $? -eq 12 ]]; then
												printf "Contact \033[1;36m%s\033[0m set as \033[1;31m%s\033[0m.\n" "$incomingEmail" 'verified'
											else
												echo "$verifyResult"
											fi
											echo
											read -rsn1 -p "Press any key to continue..." key
											;;

										"Reject Invitation")
											local ipcResult="$(mega-ipc "$incomingEmail" -d)"
											ipcResult="$(sed -E "s/([^ ]+@[^ ]+)/\\\033[1;36m\1\\\033[0m/" <<< "$ipcResult")"
											printf "$ipcResult\n"
											echo
											read -rsn1 -p "Press any key to continue..." key
											;;

										"Ignore Invitation")
											local ipcResult="$(mega-ipc "$incomingEmail" -i)"
											ipcResult="$(sed -E "s/([^ ]+@[^ ]+)/\\\033[1;36m\1\\\033[0m/" <<< "$ipcResult")"
											printf "$ipcResult\n"
											echo
											read -rsn1 -p "Press any key to continue..." key
											;;
									esac
								fi
								;;

							"Process Outgoing Request")
								printf "\033[$(( ${#pendingActions[@]} + 1 ))A\033[0J"
								local outgoingEmails=( $(grep -Eo "^ [^ ]+@[^ ]+" <<< "$outgoingRequest" | grep -Eo "[^ ]+@[^ ]+") )
								tmenu "${outgoingEmails[@]}"

								local outgoingEmail=""
								for (( i=0 ; i<${#outgoingEmails[@]} ; i++ )); do
									if [[ "$TMENU_RESULT" == "${outgoingEmails[$i]}" ]]; then
										outgoingEmail="${outgoingEmails[$i]}"
										break
									fi
								done

								if [[ ! -z "$outgoingEmail" ]]; then
									printf "\033[$(( ${#outgoingEmails[@]} + 1 ))A\033[0J"
									local outgoingActions=( "Delete Invitation" "Resend Invitation" )
									tmenu "${outgoingActions[@]}"

									case "$TMENU_RESULT" in
										"Delete Invitation")
											local confirmDelete=""
											read -rn1 -p $'Delete invitation to \033[1;31m'"$outgoingEmail"$'\033[0m? (y/N): ' confirmDelete
											if [[ "$confirmDelete" == 'y' || "$confirmDelete" == 'Y' ]]; then
												mega-invite -d "$outgoingEmail"
												if [[ $? -ne 0 ]]; then
													echo
													read -rsn1 -p "Press any key to continue..." key
												fi
											fi
											;;
									
										"Resend Invitation")
											local message=""
											read -rep $'Message: (Request resend by \033[1;32m'"$megauser"$'\033[0m) ' message
											echo

											if [[ -z "$message" ]]; then
												message="Request resend by $megauser"
											fi

											mega-invite -r "$outgoingEmail" --message="$message"

											if [[ $? -ne 0 ]]; then
												echo
												read -rsn1 -p "Press any key to continue..." key
											fi
											;;
									esac
