WDIR="$(pwd)"
ESC_KEY=$'\033'
ERROR_COLOR=91
CMD_COLOR=96

tmenu.hashCheck() {
	declare -a hashMenu

	until [[ "$TMENU_RESULT" == "EXIT" ]]; do
		clear
		printf "\033[47m\033[30m HASH check \033[0m\n------------\n\n"

		hashMenu=( "1. SHA1" "2. SHA256" "3. SHA384" "4. SHA512" "5. MD5" "6. Back" )

		tmenu "${hashMenu[@]}"

		case "$TMENU_RESULT" in
			"1. SHA1")
				echo === SHA1 ===
				sha1sum "$1"
				echo
				read -rsn1 -p "Press ESC to exit, other keys to continue..." key
				echo
				echo
				if [[ "$key" == "$ESC_KEY" ]]; then
					exit
				fi
				;;

			"2. SHA256")
				echo === SHA256 ===
				sha256sum "$1"
				echo
				read -rsn1 -p "Press ESC to exit, other keys to continue..." key
				echo
				echo
				if [[ "$key" == "$ESC_KEY" ]]; then
					exit
				fi
				;;
			
			"3. SHA384")
				echo === SHA384 ===
				sha384sum "$1"
				echo
				read -rsn1 -p "Press ESC to exit, other keys to continue..." key
				echo
				echo
				if [[ "$key" == "$ESC_KEY" ]]; then
					exit
				fi
				;;
			
			"4. SHA512")
				echo === SHA512 ===
				sha512sum "$1"
				echo
				read -rsn1 -p "Press ESC to exit, other keys to continue..." key
				echo
				echo
				if [[ "$key" == "$ESC_KEY" ]]; then
					exit
				fi
				;;
			
			"5. MD5")
				echo === MD5 ===
				md5sum "$1"
				echo
				read -rsn1 -p "Press ESC to exit, other keys to continue..." key
				echo
				echo
				if [[ "$key" == "$ESC_KEY" ]]; then
					exit
				fi
				;;

			"6. Back" | "0" | "$ESC_KEY")
				unset TMENU_RESULT
				break
				;;
		esac
	done
}

runCmd() {
	eval "$1"
	if [[ $? -ne 0 ]]; then
		TFE_ERR+=( "$1" )
	fi
}

list() {
	ListArray+=( "$1" )
}

checkRootDir() {
	local isRootDir=1
	local fileCounter=0
	for file in "$1"/*; do
		if [[ ! -d "$file" ]]; then
			(( ++fileCounter ))
		fi
		if [[ ! -d "$file" && "$1/checksums.sha256" != "$file" ]]; then
			isRootDir=0
			break
		fi
	done
	if [[ $fileCounter -eq 0 ]]; then
		isRootDir=0
	fi
	return $isRootDir
}

megaLogin() {
	megauser="$(mega-whoami 2> /dev/null)"
	if [[ $? -ne 0 ]]; then
		read -rep "Username: (chickenvnn) " megauser
		read -rsep "Password: " megapass
		read -rep "2FA code: (none) " mega2fa
		echo

		if [[ -z "$megauser" ]]; then
			megauser="chickenvnn@gmail.com"
		fi

		if [[ -z "$mega2fa" ]]; then
			mega-login "$megauser" "$megapass"
		else
			mega-login --auth-code="$mega2fa" "$megauser" "$megapass"
		fi
	fi

	if [[ $? -eq 0 ]]; then
		megauser=${megauser#Account e-mail: }
	else
		echo
		read -rsn1 -p "Press any key to continue..." key
		return -1
	fi
}

action.dir() {
	echo "Directory Action"
	echo "----------------"
	echo

	declare -a actions

	if [[ ! -z "$DST" ]]; then
		local prevDST="$(basename "$DST")"
		actions+=( "Copy to \"$prevDST\"" )
	fi

	actions+=( "Copy" )

	if [[ ! -z "$DST" ]]; then
		actions+=( "Move to \"$prevDST\"" )
	fi

	actions+=( "Move" "Delete" "Rename" "New folder" "New file" "Create checksums" "Upload to Mega.nz" )

	if [[ -f "$1/checksums.sha256" ]]; then
		actions+=( "Checksums" )
	fi

	if [[ -d "$1/.git" ]]; then
		actions+=( "Git" )
	fi

	for file in "$1"/*.deb; do
		if [[ -f "$file" ]]; then
			actions+=( "Install" )
			break
		fi
	done

	checkRootDir "$1"
	if [[ $? -eq 1 ]]; then
		actions+=( "Install all" )
	fi

	actions+=( "Magick" )
	if [[ -f "$1/package.json" ]]; then
		actions+=( "Install Node.js" )
	fi
	actions+=( "Zip" )
	if [[ ! -z "$DST" ]]; then
		actions+=( "Zip to \"$prevDST\"" )
	fi
	actions+=( "Detail" )

	tmenu "${actions[@]}"

	case "$TMENU_RESULT" in
		"Copy to \"$prevDST\"")
			cp -rf "./$1" "$DST"
			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Copy")
			tmenu.fileExplorer "slDst"
			if [[ "$TMENU_RESULT" == "$ESC_KEY" ]]; then
				local cDST=""
				read -rep "Destination: (cancel) " cDST
				echo
				eval cDST="$cDST"
				if [[ ! -z "$cDST" ]]; then
					cp -rf "./$1" "$cDST"
				fi
			else
				cp -rf "./$1" "$DST"
			fi

			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Move to \"$prevDST\"")
			if [[ "$1" == "." ]]; then
				local currentDir="$(basename "$WDIR")"
				cd ..
				WDIR="$(pwd)"
				mv "$currentDir" "$DST"
			else
				mv "./$1" "$DST"
			fi
			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Move")
			tmenu.fileExplorer "slDst"
			local mDST=""
			if [[ "$TMENU_RESULT" == "$ESC_KEY" ]]; then
				read -rep "Destination: (cancel) " iDST
				echo
				eval iDST="$iDST"
				if [[ ! -z "$iDST" ]]; then
					mDST="$iDST"
				fi
			else
				mDST="$DST"
			fi
			if [[ "$1" == "." ]]; then
				local currentDir="$(basename "$WDIR")"
				cd ..
				WDIR="$(pwd)"
				mv "$currentDir" "$mDST"
			else
				mv "./$1" "$mDST"
			fi

			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Delete")
			local msg=""
			local dotOpt=""

			if [[ "$1" == "." ]]; then
				msg="Delete **All**? (y/N): "
			else msg="Delete \"$1\"? (y/N): "
			fi

			read -rn1 -p "$msg" key
			echo
			echo

			if [[ "$key" == "y" || "$key" == "Y" ]]; then
				if [[ "$1" == "." ]]; then
          			dotOpt=$(shopt -p dotglob)
          			dotOpt=${dotOpt:7:1}
					if [[ "$dotOpt" == "u" ]]; then
						shopt -s dotglob
						rm -rf ./*
					else rm -rf ./*
					fi
				else rm -rf "./$1"
				fi

				if [[ $? -ne 0 ]]; then
					echo
					read -rsn1 -p "Press any key to continue..." key
				else unset prevItem
				fi

				if [[ "$dotOpt" == "u" ]]; then
					shopt -u dotglob
				fi
			fi
			;;

		"Rename")
			local newName=""
			read -rep "New name: (cancel) " newName
			echo
			eval newName="$newName"
			if [[ ! -z "$newName" ]]; then
				mv "./$1" "$newName"
			fi

			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"New folder")
			local fName=""
			read -rep "Folder name: (cancel) " fName
			echo
			eval fName="$fName"
			if [[ ! -z "$fName" ]]; then
				mkdir "$1/$fName"
			fi

			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"New file")
			local fName=""
			read -rep "File name: (cancel) " fName
			echo
			eval fName="$fName"
			if [[ ! -z "$fName" ]]; then
				cd "$1"
				touch "$fName"
				cd "$WDIR"
			fi

			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Create checksums")
			cd "$1"
			rm -f checksums.sha256 2> /dev/null
			find . -mindepth 1 -name '.git' -prune -o -name 'node_modules' -prune -o -name 'build' -prune -o \( -type f -a ! -name 'checksums.sha256' \) -exec sha256sum '{}' >> checksums.sha256 \;
			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			cd "$WDIR"
			;;

		"Upload to Mega.nz")
			local srcPath=""
			if [[ "$1" == '.' ]]; then
				srcPath="$WDIR"
			elif [[ "$1" == '..' ]]; then
				srcPath="$(sed -E s/^\(.*\)\\/.*/"\1"/ <<< "$WDIR")"
			else
				srcPath="$WDIR/$1"
			fi

			tmenu.megaExplorer "megaSlDst"
			if [[ $? -eq 0 ]]; then
				if [[ "$TMENU_RESULT" != "$ESC_KEY" ]]; then
					mega-put "$srcPath" "$TMENU_RESULT"
					echo
					read -rsn1 -p "Press any key to continue..." key
				fi
			fi
			;;

		"Checksums")
			cd "$1"
			sha256sum -c "checksums.sha256" 1> /dev/null
			if [[ $? -eq 0 ]]; then
				echo "All files checked OK."
			fi
			echo
			read -rsn1 -p "Press any key to continue..." key
			cd "$WDIR"
			;;

		"Git")
			local cMsg=""
			cd "$1"
			read -rn1 -p "(p)ull|(P)ush|(c)heckout? (push) " key
			echo

			if [[ -z "$key" || "$key" == "P" ]]; then
				read -rep "Message: (cancel) " cMsg
				echo
				if [[ ! -z "$cMsg" ]]; then
					git add .
					git commit -m "$cMsg"
					git push
					echo
					read -rsn1 -p "Press any key to continue..." key
				fi
			elif [[ "$key" == "p" ]]; then
				echo
				git pull
				echo
				read -rsn1 -p "Press any key to continue..." key
			elif [[ "$key" == "c" ]]; then
				read -rep "Branch|File name: (cancel) " check
				echo
				if [[ ! -z "$check" ]]; then
					git checkout "$check"
					echo
					read -rsn1 -p "Press any key to continue..." key
				fi
			fi

			cd "$WDIR"
			;;

		"Install")
			cd "$1"
			dpkg -i *.deb
			echo
			read -rsn1 -p "Press any key to continue..." key
			cd "$WDIR"
			;;

		"Install all")
			cd "$1"
			dpkg -i -R .
			echo
			read -rsn1 -p "Press any key to continue..." key
			cd "$WDIR"
			;;

		"Magick")
			local zDst
			local pDir=".."
			local zName="$1"
			if [[ "$1" == "." ]]; then
				zName="${WDIR##*/}"
				pDir="."
			fi
			echo "Resample *.jpg and create archive \"${zName}.zip\"?"
			read -rn1 -p "(p)ath|(c)ancel: (ok) " key
			echo
			if [[ -z "$key" ]]; then
				mkdir "$1/$zName"
				magick mogrify -identify -path "$1/$zName" -resample 10% "$1/*.jpg"
				cd "$1"
				7zz a -snl "$pDir/${zName}.zip" "$zName/."
				rm -rf "$zName"
				cd "$pDir"
				echo
				read -rn1 -p "Move zipped to \"Upload\"? (ok) " key
				if [[ -z "$key" ]]; then
					mv "${zName}.zip" "/storage/emulated/0/Upload"
				fi
			elif [[ "$key" == "p" || "$key" == "P" ]]; then
				read -rep "Archive path/name: " zDst
				echo
				eval zDst="$zDst"
				mkdir "$1/$zName"
				magick mogrify -identify -path "$1/$zName" -resample 10% "$1/*.jpg"
				cd "$1"
				if [[ "$zDst" != *"/"* || "$zDst" == "./"* || "$zDst" == "../"* ]]; then
					7zz a -snl "$pDir/$zDst" "$zName/."
				else 7zz a -snl "$zDst" "$zName/."
				fi
				rm -rf "$zName"
				echo
				read -rn1 -p "Move zipped to \"Upload\"? (ok) " key
				if [[ -z "$key" ]]; then
					if [[ "$zDst" != *"/"* || "$zDst" == "./"* || "$zDst" == "../"* ]]; then
						mv "$pDir/$zDst" "/storage/emulated/0/Upload"
					else mv "$zDst" "/storage/emulated/0/Upload"
					fi
				fi
				cd "$pDir"
			else return
			fi
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Install Node.js")
			cd "$1"
			npm install
			cd "$WDIR"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Zip")
			local zDst
			local zName="$1.zip"
			if [[ "$1" == "." ]]; then
				zName="${WDIR##*/}.zip"
			fi
			echo "Create archive \"$zName\"?"
			read -rn1 -p "(p)ath|(c)ancel: (ok) " key
			if [[ -z "$key" ]]; then
				7zz a -snl "$zName" "$1"
			elif [[ "$key" == "p" || "$key" == "P" ]]; then
				echo
				read -rep "Archive path/name: " zDst
				eval zDst="$zDst"
				7zz a -snl "$zDst" "$1"
			else return
			fi
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Zip to \"$prevDST\"")
			local aName="$1"
			if [[ "$aName" == "." ]]; then
				aName="$(basename "$WDIR")"
			fi
			7zz a -snl "$DST/$aName.zip" "$1"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Detail")
			echo "Directory Detail"
			echo "----------------"
			echo
			echo "Size: $(du -sh "$1")"
			echo
			ls -lh "$1"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;
	esac
}

action.file() {
	declare -a actions
	local dir="$WDIR"

	echo "File Action"
	echo "-----------"
	echo

	if [[ ! -z "$DST" ]]; then
		local prevDST="$(basename "$DST")"
		actions+=( "Copy to \"$prevDST\"" )
	fi

	actions+=( "Copy" )

	if [[ ! -z "$DST" ]]; then
		actions+=( "Move to \"$prevDST\"" )
	fi

	actions+=( "Move" "Delete" "Rename" "Edit" "Hash check" "Upload to Mega.nz" )

	if [[ "$1" == "checksums.sha256" ]]; then
		actions+=( "Checksums" )
	fi

	while [[ ! -z "$dir" ]]; do
		if [[ -r "$dir" ]]; then
			if [[ -d "$dir/.git" ]]; then
				actions+=( "Git checkout" )
				break
			else
				dir="${dir%/*}"
			fi
		else break
		fi
	done

	if [[ -x "$1" ]]; then
		actions+=( "Run" )
	fi

	case "$1" in
		*".deb")
			actions+=( "Install" )
			;;

		*".zip"|*".7z"|*".gz"|*".xz"|*".tar"|*".rar")
			actions+=( "Extract" )
			;;

		*".sh")
			if [[ ! -x "$1" ]]; then
				actions+=( "Run Shell" )
			fi
			;;

		*".js"|*".cjs"|*".mjs")
			actions+=( "Run Node.js" "Run NodeMon" )
			;;

		*".class")
			actions+=( "Run Java" )
			;;

		*".java")
			actions+=( "Compile Java" )
			;;

		*".txt")
			actions+=( "to JSON" )
			;;
	esac

	actions+=( "Detail" )

	tmenu "${actions[@]}"

	case "$TMENU_RESULT" in
		"Copy to \"$prevDST\"")
			cp -f "./$1" "$DST"
			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Copy")
			local cDST=""
			tmenu.fileExplorer "slDst"
			if [[ "$TMENU_RESULT" == "$ESC_KEY" ]]; then
				read -rep "Destination: (cancel) " cDST
				echo
				eval cDST="$cDST"
				if [[ ! -z "$cDST" ]]; then
					cp -f "./$1" "$cDST"
				fi
			else
				cp -f "./$1" "$DST"
			fi

			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Move to \"$prevDST\"")
			mv "./$1" "$DST"
			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Move")
			tmenu.fileExplorer "slDst"
			if [[ "$TMENU_RESULT" == "$ESC_KEY" ]]; then
				local mDST=""
				read -rep "Destination: (cancel) " mDST
				echo
				eval mDST="$mDST"
				if [[ ! -z "$mDST" ]]; then
					mv "./$1" "$mDST"
				fi
			else
				mv "./$1" "$DST"
			fi

			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Delete")
			local msg="Delete \"$1\"? (y/N): "
			read -rn1 -p "$msg" key
			echo
			echo

			if [[ "$key" == "y" || "$key" == "Y" ]]; then
				rm -f "./$1"
				if [[ $? -ne 0 ]]; then
					echo
					read -rsn1 -p "Press any key to continue..." key
				else unset prevItem
				fi
			fi
			;;

		"Rename")
			local newName=""
			read -rep "New name: (cancel) " newName
			echo
			eval newName="$newName"
			if [[ ! -z "$newName" ]]; then
				mv "./$1" "$newName"
			fi

			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Edit")
			vim "$1"
			;;

		"Hash check")
			tmenu.hashCheck "$1"
			;;

		"Upload to Mega.nz")
			tmenu.megaExplorer "megaSlDst"
			if [[ $? -eq 0 ]]; then
				if [[ "$TMENU_RESULT" != "$ESC_KEY" ]]; then
					mega-put "$1" "$TMENU_RESULT"
					echo
					read -rsn1 -p "Press any key to continue..." key
				fi
			fi
			;;

		"Checksums")
			sha256sum -c "checksums.sha256" 1> /dev/null
			if [[ $? -eq 0 ]]; then
				echo "All files checked OK."
			fi
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Git checkout")
			read -rn1 -p "Recover \"$1\"? (y/N): " key
			echo
			if [[ "$key" == "y" || "$key" == "Y" ]]; then
				git checkout "$1"
			fi
			;;

		"Run")
			"./$1"
			;;

		"Install")
			dpkg -i $1
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Extract")
			local zDst
			read -rep "Destination: " zDst
			eval zDst="$zDst"
			7zz x -o"$zDst" "$1"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Run Shell")
			bash "$1"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Run Node.js")
			node "$1"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Run NodeMon")
			nodemon "$1"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Run Java")
			java "${1:0: -6}"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Compile Java")
			javac "$1" && java "${1:0: -5}"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"to JSON")
			local fName="${1:0:-3}json"
			local firstLine=""
			while IFS= read -r line; do
				if [[ -z "$firstLine" ]]; then
					if [[ ! -z "$line" ]]; then
						printf "[\n\t\"$line\"" >> "$fName"
						firstLine="$line"
					fi
				elif [[ ! -z "$line" ]]; then
					printf ",\n\t\"$line\"" >> "$fName"
				fi
			done < "$1"
			if [[ ! -z "$firstLine" ]]; then
				printf "\n]\n\n" >> "$fName"
			fi
			unset IFS
			;;

		"Detail")
			echo "File Detail"
			echo "----------------"
			echo
			echo "Size: $(du -sh "$1")"
			echo
			ls -lh "$1"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;
	esac
}

tmenu.fileExplorer() {
	SRC="$(pwd)"
	local title=""
	local prevItem=""
	unset MEGA_FILE_TYPES

	until [[ "$TMENU_RESULT" == "EXIT" ]]; do
		local file_list=( "." ".." )
		local checkPrev=0

		if [[ -z "$1" ]]; then
			title="\033[44m FILE EXPLORER \033[0m\n\033[44m---------------\033[0m\n\nPath: \033[1;36m$(pwd)\033[0m\n(0: Action | 1: Directory)\n\n"
		elif [[ "$1" == "slDst" ]]; then
			title="\033[46m SELECT DESTINATION \033[0m\n--------------------\n\nPath: \033[1;36m$(pwd)\033[0m\n(0: Select)\n\n"
		elif [[ "$1" == "slFile" ]]; then
			title="\033[46m SELECT FILE/FOLDER \033[0m\n--------------------\n\nPath: \033[1;36m$(pwd)\033[0m\n(0: Select)\n\n"
		fi

		for file in *; do
			if [[ -d "$file" ]]; then
				file_list+=( "$file" )
			fi
			if [[ "$prevItem" == "$file" ]]; then
				checkPrev=1
			fi
		done

		for file in *; do
			if [[ -f "$file" ]]; then
				file_list+=( "$file" )
			fi
		done

		clear
		printf "$title"

		if [[ -z "$prevItem" || ! -z "$prevItem" && $checkPrev == 0 ]]; then
			if [[ ! -z "${file_list[2]}" ]]; then
				prevItem=${file_list[2]}
			else
				prevItem=".."
			fi
		fi
		
		tmenu "$prevItem" "${file_list[@]}"
		
		prevItem="$MENU_SELECTED"

		if [[ "$TMENU_RESULT" == "$ESC_KEY" ]]; then
			break
		elif [[ "$TMENU_RESULT" == 0 ]]; then
			if [[ "$1" == "slDst" ]]; then
				DST="$(pwd)"
				TMENU_RESULT="$DST"
				break
			elif [[ "$1" == "slFile" ]]; then
				if [[ "$MENU_SELECTED" == '.' ]]; then
					TMENU_RESULT="$WDIR"
				elif [[ "$MENU_SELECTED" == '..' ]]; then
					TMENU_RESULT="$(sed -E s/^\(.*\)\\/.*/"\1"/ <<< "$WDIR")"
				else
					TMENU_RESULT="$WDIR/$MENU_SELECTED"
				fi
				break
			elif [[ -d "$MENU_SELECTED" ]]; then
				action.dir "$MENU_SELECTED"
			else
				action.file "$MENU_SELECTED"
			fi
		elif [[ "$TMENU_RESULT" == "." ]]; then
			action.dir "$TMENU_RESULT"
		elif [[ -d "$TMENU_RESULT" ]]; then
			cd "$TMENU_RESULT" 
			WDIR="$(pwd)"
			if [[ -z "$1" ]]; then
				SRC="$(pwd)"
			fi
			unset prevItem
		elif [[ -f "$TMENU_RESULT" ]]; then
			action.file "$TMENU_RESULT"
		fi
	done
	if [[ "$1" == "slDst" || "$1" == "slFile" ]]; then
		cd "$SRC"
		WDIR="$SRC"
	fi
}

getMegaUsedStorage() {
	megaUsedStorage="$(mega-df -h | grep -iE 'storage' | sed -E s/^.{24}/'Usage: '/ | sed -E s/' '{23}/'  - '/)"
}

getMegaUsedTrashBin() {
	megaUsedTrashBin="$(mega-df -h | grep -iE 'rubbish' | sed -E s/^.{24}/'Trash: '/ | sed -E s/' and'//)"
}

action.megaDir() {
	unset MEGA_FILE_TYPES

	echo "Mega Directory Action"
	echo "---------------------"
	echo

	local actions=( "Upload" )

	if [[ ! -z "$DST" ]]; then
		local prevDST="$(basename "$DST")"
		actions+=( "Download to \"$prevDST\"" )
	fi

	actions+=( "Download" "Copy" "Move" )

	if [[ "$1" == '.' && "$MEGAWDIR" == '//bin' ]]; then
		actions+=( "Empty Trash" )
	elif [[ "$MEGAWDIR" == '//bin'* ]]; then
		actions+=( "Delete" )
	else
		actions+=( "Move to Trash" )
	fi

	actions+=( "Rename" "New folder" "Usage" "Detail" )

	tmenu "${actions[@]}"

	case "$TMENU_RESULT" in
		"Upload")
			tmenu.fileExplorer "slFile"
			if [[ "$TMENU_RESULT" != "$ESC_KEY" ]]; then
				mega-put "$TMENU_RESULT" "$1"
				getMegaUsedStorage
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Download to \"$prevDST\"")
			mega-get "$1" "$DST"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Download")
			tmenu.fileExplorer "slDst"
			if [[ "$TMENU_RESULT" != "$ESC_KEY" ]]; then
				mega-get "$1" "$TMENU_RESULT"
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Copy")
			tmenu.megaExplorer "megaSlDst"
			if [[ "$TMENU_RESULT" != "$ESC_KEY" ]]; then
				mega-cp "$1" "$TMENU_RESULT"
				if [[ $? -eq 0 ]]; then
					echo "Copy finished: $TMENU_RESULT/$1"
					getMegaUsedStorage
				fi
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Move")
			local movedPath=""
			tmenu.megaExplorer "megaSlDst"
			if [[ "$TMENU_RESULT" != "$ESC_KEY" ]]; then
				mega-mv "$1" "$TMENU_RESULT"
				if [[ $? -eq 0 ]]; then
					movedPath="$TMENU_RESULT/$1"
					if [[ "$1" == '.' ]]; then
						MEGAWDIR="$(mega-pwd)"
						movedPath="$MEGAWDIR"
					fi
					echo "Move finished: $movedPath"
				fi
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Empty Trash")
			local msg="Clear \033[1;31m%s\033[0m? (y/N): "
			printf "$msg" "Trash bin"
			read -rn1 key
			echo
			echo

			if [[ "$key" == "y" || "$key" == "Y" ]]; then
				mega-rm -rf "//bin/*"
				if [[ $? -ne 0 ]]; then
					echo
					read -rsn1 -p "Press any key to continue..." key
				else
					unset prevItem
				fi
				getMegaUsedTrashBin
				getMegaUsedStorage
			fi
			;;

		"Move to Trash")
			if [[ "$1" == '.' && "$MEGAWDIR" == '/' ]]; then
				local msg="Can't move root \033[1;31m%s\033[0m to Trash bin. "
				printf "$msg" "$MEGAWDIR"
				read -rsn1 key
				return -1
			fi

			local dirName="$1"
			local msg="Move \033[1;31m%s\033[0m to Trash bin? (y/N): "
			if [[ "$1" == '.' ]]; then
				dirName="$(basename "$MEGAWDIR")"
				local parentDir="$(sed -E s/^\(.*\)\\/.*/"\1"/ <<< "$MEGAWDIR")"
			fi
			printf "$msg" "$dirName"
			read -rn1 key
			echo
			echo

			if [[ "$key" == "y" || "$key" == "Y" ]]; then
				mega-mv "$1" '//bin'
				if [[ $? -ne 0 ]]; then
					echo
					read -rsn1 -p "Press any key to continue..." key
				else
					if [[ "$1" == '.' ]]; then
						mega-cd "$parentDir"
						MEGAWDIR="$parentDir"
					fi
					getMegaUsedTrashBin
					unset prevItem
				fi
			fi
			;;

		"Delete")
			local dirName="$1"
			local msg="Delete \033[1;31m%s\033[0m permanently? (y/N): "
			if [[ "$1" == '.' ]]; then
				dirName="$(basename "$MEGAWDIR")"
				local parentDir="$(sed -E s/^\(.*\)\\/.*/"\1"/ <<< "$MEGAWDIR")"
			fi
			printf "$msg" "$dirName"
			read -rn1 key
			echo
			echo

			if [[ "$key" == "y" || "$key" == "Y" ]]; then
				mega-rm -rf "$1"
				if [[ $? -ne 0 ]]; then
					echo
					read -rsn1 -p "Press any key to continue..." key
				else
					if [[ "$1" == '.' ]]; then
						mega-cd "$parentDir"
						MEGAWDIR="$parentDir"
					fi
					getMegaUsedTrashBin
					getMegaUsedStorage
					unset prevItem
				fi
			fi
			;;

		"Rename")
			local newName=""
			read -rep "New name: (cancel) " newName
			echo
			if [[ ! -z "$newName" ]]; then
				mega-mv "$1" "$newName"
			fi

			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"New folder")
			local fName=""
			read -rep "Folder name: (cancel) " fName
			echo
			if [[ ! -z "$fName" ]]; then
				mega-mkdir "$1/$fName"
			fi

			if [[ $? -ne 0 ]]; then
				echo
				read -rsn1 -p "Press any key to continue..." key
			fi
			;;

		"Usage")
			local item="$1"
			if [[ "$item" == '.' ]]; then
				item='*'
			elif [[ "$item" == '..' ]]; then
				if [[ "$MEGAWDIR" == '/' || "$MEGAWDIR" == '//bin' ]]; then
					item='*'
				else
					item="$(sed -E s/^\(.*\)\\/.*/"\1"/ <<< "$MEGAWDIR")/*"
				fi
			fi
			mega-du -h "$item"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;

		"Detail")
			local item="$1"
			if [[ "$item" == '..' ]]; then
				if [[ "$MEGAWDIR" == '/' || "$MEGAWDIR" == '//bin' ]]; then
					item='.'
				else
					item="$(sed -E s/^\(.*\)\\/.*/"\1"/ <<< "$MEGAWDIR")/."
				fi
			fi
			mega-ls -lh --show-handles "$item"
			echo
			read -rsn1 -p "Press any key to continue..." key
			;;
	esac
}

