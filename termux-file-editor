tmenu.megaExplorer() {
	megaLogin
	if [[ $? -ne 0 ]]; then
		return -1
	fi

	MEGAWDIR="$(mega-pwd)"
	MEGASRC="$MEGAWDIR"
	MEGADST="$MEGAWDIR"
	local title=""
	local prevItem=""
	local index=-1

	if [[ "$MEGAWDIR" == '//bin'* ]]; then
		if [[ "$1" == "megaSlDst" || "$1" == "megaSlFile" ]]; then
			if [[ "$MEGASRC" == '//bin'* ]]; then
				MEGASRC="/"
			fi
			mega-cd "$MEGASRC"
			MEGAWDIR="$MEGASRC"
		else
			getMegaUsedTrashBin
		fi
	else
		getMegaUsedStorage
	fi

	until [[ "$TMENU_RESULT" == "EXIT" ]]; do
		local file_list=( "." ".." )
		MEGA_FILE_TYPES=( "d" "d" )
		local checkPrev=0
		if [[ "$prevItem" == '.' || "$prevItem" == '..' ]]; then
			prevItem=""
		fi

		clear
		if [[ -z "$1" ]]; then
			if [[ "$MEGAWDIR" == '//bin'* ]]; then
				title="\033[42m MEGA FILE EXPLORER (\033[1;31m$megauser\033[0m\033[42m)              \033[0m\n\033[42m--------------------------------------------------------\033[0m\n\033[47m\033[1;30m %s \033[0m\n\nPath: \033[1;36m$MEGAWDIR\033[0m\n(0: Action | 1: Directory | Esc+t: Files | Esc+m: Menu)\n\n"
				printf "$title" "$megaUsedTrashBin"
			else
				title="\033[42m MEGA FILE EXPLORER (\033[1;31m$megauser\033[0m\033[42m)     \033[0m\n\033[42m-----------------------------------------------\033[0m\n\033[47m\033[1;30m %s       \033[0m\n\nPath: \033[1;36m$MEGAWDIR\033[0m\n(0: Action | 1: Directory | Esc+t: Trash | Esc+m: Menu)\n\n"
				printf "$title" "$megaUsedStorage"
			fi
		elif [[ "$1" == "megaSlDst" ]]; then
			title="\033[41m MEGA SELECT DESTINATION \033[0m\n-------------------------\n\nPath: \033[1;36m$MEGAWDIR\033[0m\n(0: Select)\n\n"
			printf "$title"
		elif [[ "$1" == "megaSlFile" ]]; then
			title="\033[41m MEGA SELECT FILE/FOLDER \033[0m\n-------------------------\n\nPath: \033[1;36m$MEGAWDIR\033[0m\n(0: Select)\n\n"
			printf "$title"
		fi

		local prevIFS="$IFS"
		while IFS= read -r line; do
			file_list+=( "${line% (folder)}" )
			MEGA_FILE_TYPES+=( "d" )
		done < <(mega-ls -a | grep -i "(folder)$")

		while IFS= read -r line; do
    		file_list+=( "$line" )
			MEGA_FILE_TYPES+=( "f" )
		done < <(mega-ls -a | grep -iv "(folder)$" | sed -E s/' \(.+ .+\)$'//)
		IFS="$prevIFS"

		for file in "${file_list[@]}"; do
			if [[ "$file" == "$prevItem" ]]; then
				checkPrev=1
				break
			fi
		done

		if [[ -z "$prevItem" || ! -z "$prevItem" && $checkPrev == 0 ]]; then
			if [[ ! -z "${file_list[2]}" ]]; then
				prevItem=${file_list[2]}
			else
				prevItem=".."
			fi
		fi
		
		tmenu "$prevItem" "${file_list[@]}"
		
		prevItem="$MENU_SELECTED"

		for (( i=0 ; i<${#file_list[@]} ; i++ )); do
			local file="${file_list[$i]}"
			if [[ "$file" == "$MENU_SELECTED" ]]; then
				index=$i
				break
			fi
		done

		if [[ "$TMENU_RESULT" == "$ESC_KEY" ]]; then
			break
		elif [[ "$TMENU_RESULT" == "$ESC_KEY"'l' ]]; then
			mega-transfers --show-completed --limit=50 --output-cols=TYPE,SOURCEPATH,DESTINYPATH,PROGRESS
			echo
			read -rsn1 -p "Press any key to continue..." key
		elif [[ "$TMENU_RESULT" == "$ESC_KEY"'t' ]]; then
			if [[ "$MEGAWDIR" == '//bin'* ]]; then
				if [[ "$MEGASRC" == '//bin'* ]]; then
					MEGASRC="/"
				fi
				mega-cd "$MEGASRC"
				MEGAWDIR="$MEGASRC"
				if [[ -z "$megaUsedStorage" ]]; then
					getMegaUsedStorage
				fi
			else
				MEGASRC="$MEGAWDIR"
				mega-cd "//bin"
				MEGAWDIR="//bin"
				if [[ -z "$megaUsedTrashBin" ]]; then
					getMegaUsedTrashBin
				fi
			fi
		elif [[ "$TMENU_RESULT" == 0 ]]; then
			if [[ "$1" == "megaSlDst" ]]; then
				MEGADST="$(mega-pwd)"
				TMENU_RESULT="$MEGADST"
				break
			elif [[ "$1" == "megaSlFile" ]]; then
				if [[ "$MENU_SELECTED" == '.' ]]; then
					TMENU_RESULT="$MEGAWDIR"
				elif [[ "$MENU_SELECTED" == '..' ]]; then
					TMENU_RESULT="$(sed -E s/^\(.*\)\\/.*/"\1"/ <<< "$MEGAWDIR")"
				else
					TMENU_RESULT="$MEGAWDIR/$MENU_SELECTED"
				fi
				break
			elif [[ "${MEGA_FILE_TYPES[$index]}" == 'd' ]]; then
				action.megaDir "$MENU_SELECTED"
			else
				action.megaFile "$MENU_SELECTED"
			fi
		elif [[ "$TMENU_RESULT" == "." ]]; then
			action.megaDir "$TMENU_RESULT"
		elif [[ "$TMENU_RESULT" == "${file_list[$index]}" && "${MEGA_FILE_TYPES[$index]}" == 'd' ]]; then
			if [[ "$TMENU_RESULT" == '..' && "$MEGAWDIR" == '//bin' ]]; then
				if [[ "$MEGASRC" == '//bin'* ]]; then
					MEGASRC='/'
				fi
				mega-cd "$MEGASRC"
				MEGAWDIR="$MEGASRC"
			elif [[ "$TMENU_RESULT" == '..' && "$MEGAWDIR" == '/' ]]; then
				continue
			else
				mega-cd "$TMENU_RESULT"
				MEGAWDIR="$(mega-pwd)"
			fi
		elif [[ "$TMENU_RESULT" == "${file_list[$index]}" && "${MEGA_FILE_TYPES[$index]}" == 'f' ]]; then
			action.megaFile "$TMENU_RESULT"
		fi
	done

	if [[ "$1" == "megaSlDst" || "$1" == "megaSlFile" ]]; then
		mega-cd "$MEGASRC"
		MEGAWDIR="$MEGASRC"
	fi
	unset MEGA_FILE_TYPES
}

tmenu.parseTCMD() {
	while IFS= read -r line; do
		if [[ -z "$TCMD_SRC" ]]; then
			TCMD_SRC="$line"
		elif [[ -z "$TCMD_DST" ]]; then
			TCMD_DST="${line:0:-1}"
			DST="${line:0:-1}"
		elif [[ -z "$TCMD_ACT" ]]; then
			TCMD_ACT="$line"
		fi
	done < "$1"
	unset IFS
	echo "$(date +"%x %X") :: $TCMD_SRC" >> ~/.tfe_history

	case "$TCMD_ACT" in
		"hash") tmenu.hashCheck "$TCMD_SRC" ;;

		"explorer")
			local srcPath=${TCMD_SRC%/*}
			cd "$srcPath"
			WDIR="$srcPath"
			tmenu.fileExplorer
			;;
	esac
}

# Starting Point (main)
if [[ ! -z "$1" ]]; then
	tmenu.parseTCMD "$1"
fi

