					clear
					local title="\033[41m MEGA CONTACT MANAGER (\033[1;32m%s\033[0m\033[41m) ${lineSpacer:0:$(( ${#lineSpacer} - 25 - ${#megauser} ))}\033[0m\n\033[41m%s\033[0m\n\033[47m\033[1;30m %s ${lineSpacer:0:$(( ${#lineSpacer} - 2 - ${#storageInfo} ))}\033[0m\n\n[D:\033[1;34m%s\033[0m | F:\033[1;33m%s\033[0m] \033[1;36m%s\033[0m\n(Esc+l: Logout | Esc+m: Back)\n\n"
					printf "$title" "$megauser" "$lineSeparator" "$storageInfo" "$numDir" "$numFile" "$MEGAWDIR"
				done
				;;

			"Delete Contact")
				printf "\033[$(( ${#menuContacts[@]} + 1 ))A\033[0J"
				local contactEmails=( $(grep -Eo " [^ ]+@[^ ]+\. " <<< "$contacts" | sed -E "s/^ ([^ ]+@[^ ]+)\. /\1/") )
				tmenu "${contactEmails[@]}"

				local contactEmail=""
				for (( i=0 ; i<${#contactEmails[@]} ; i++ )); do
					if [[ "$TMENU_RESULT" == "${contactEmails[$i]}" ]]; then
						contactEmail="${contactEmails[$i]}"
						break
					fi
				done

				if [[ ! -z "$contactEmail" ]]; then
					local confirmDelete=""
					read -rn1 -p $'Delete contact \033[1;31m'"$contactEmail"$'\033[0m? (y/N): ' confirmDelete
					if [[ "$confirmDelete" == 'y' || "$confirmDelete" == 'Y' ]]; then
